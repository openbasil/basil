#
# File contexts for the static Basil measurement-helper pieces (basil-uvsx).
# Installed once per host with basil_lsm_base; per-generation contexts live
# in basil_attestor.fc.in.
#
# Both root-owned installed evidence stores are labeled here: the allowlist
# generations under policy.d and the authority-manifest evidence store under
# manifest.d, which the helper reads on every measurement to derive
# confinement expectations (basil-6gmc).

/usr/bin/basil-measure-helper		--	system_u:object_r:basil_measure_exec_t:s0
/usr/libexec/basil/basil-attestor	--	system_u:object_r:basil_attestor_exec_t:s0
/etc/basil/measure/policy\.d(/.*)?		system_u:object_r:basil_measure_policy_t:s0
/etc/basil/measure/manifest\.d(/.*)?		system_u:object_r:basil_measure_manifest_t:s0
/run/basil/measure(/.*)?			system_u:object_r:basil_measure_var_run_t:s0
