index 0000000000000000000000000000000000000000..a62a4d60fc84425c337c8bf9cca290537f4bf31f
--- /dev/null
+++ b/tests/functional/nix-cache-signing/external-signer.py
@@ -0,0 +1,276 @@
+#!/usr/bin/env python3
+
+import argparse
+import base64
+import ctypes
+import ctypes.util
+import json
+import os
+import socket
+import struct
+import time
+from pathlib import Path
+
+
+HEADER = struct.Struct("!4sBBBBII16s16s")
+DESCRIBE_REQUEST = 0x01
+DESCRIBE_RESPONSE = 0x81
+SIGN_REQUEST = 0x02
+SIGN_RESPONSE = 0x82
+ZERO_ID = "00" * 16
+
+
+def load_sodium():
+    name = ctypes.util.find_library("sodium")
+    if name is None:
+        raise RuntimeError("could not find libsodium")
+    try:
+        library = ctypes.CDLL(name)
+    except OSError as original_error:
+        # Component builds expose libnixutil through the test library path;
+        # loading it globally also loads its version-pinned libsodium dependency.
+        library_paths = os.pathsep.join(
+            os.environ.get(variable, "") for variable in ("LD_LIBRARY_PATH", "DYLD_LIBRARY_PATH")
+        )
+        for directory in library_paths.split(os.pathsep):
+            if not directory:
+                continue
+            for candidate in Path(directory).glob("libnixutil*"):
+                if not candidate.is_file():
+                    continue
+                try:
+                    ctypes.CDLL(str(candidate), mode=ctypes.RTLD_GLOBAL)
+                    library = ctypes.CDLL(name)
+                    break
+                except OSError:
+                    continue
+            else:
+                continue
+            break
+        else:
+            raise original_error
+    byte_pointer = ctypes.POINTER(ctypes.c_ubyte)
+    library.sodium_init.restype = ctypes.c_int
+    library.crypto_sign_seed_keypair.argtypes = [byte_pointer, byte_pointer, byte_pointer]
+    library.crypto_sign_seed_keypair.restype = ctypes.c_int
+    library.crypto_sign_detached.argtypes = [
+        byte_pointer,
+        ctypes.POINTER(ctypes.c_ulonglong),
+        byte_pointer,
+        ctypes.c_ulonglong,
+        byte_pointer,
+    ]
+    library.crypto_sign_detached.restype = ctypes.c_int
+    if library.sodium_init() < 0:
+        raise RuntimeError("could not initialize libsodium")
+    return library
+
+
+def keypair(library, seed):
+    public_key = (ctypes.c_ubyte * 32)()
+    secret_key = (ctypes.c_ubyte * 64)()
+    seed_buffer = (ctypes.c_ubyte * 32).from_buffer_copy(seed)
+    if library.crypto_sign_seed_keypair(public_key, secret_key, seed_buffer) != 0:
+        raise RuntimeError("could not derive Ed25519 keypair")
+    return bytes(public_key), secret_key
+
+
+def sign(library, secret_key, message):
+    signature = (ctypes.c_ubyte * 64)()
+    signature_length = ctypes.c_ulonglong()
+    message_buffer = (ctypes.c_ubyte * len(message)).from_buffer_copy(message)
+    if (
+        library.crypto_sign_detached(
+            signature,
+            ctypes.byref(signature_length),
+            message_buffer,
+            len(message),
+            secret_key,
+        )
+        != 0
+        or signature_length.value != 64
+    ):
+        raise RuntimeError("could not sign fingerprint")
+    return bytes(signature)
+
+
+def read_exact(connection, length):
+    result = bytearray()
+    while len(result) < length:
+        chunk = connection.recv(length - len(result))
+        if not chunk:
+            raise RuntimeError("early EOF")
+        result.extend(chunk)
+    return bytes(result)
+
+
+def read_request(connection):
+    fields = HEADER.unpack(read_exact(connection, HEADER.size))
+    magic, major, minor, message_type, status, flags, body_length, batch_id, request_id = fields
+    if (
+        magic != b"NXSG"
+        or major != 1
+        or minor != 0
+        or status != 0
+        or flags != 0
+        or message_type not in (DESCRIBE_REQUEST, SIGN_REQUEST)
+        or batch_id == bytes(16)
+        or request_id == bytes(16)
+    ):
+        raise RuntimeError("invalid request header")
+    body = read_exact(connection, body_length)
+    if connection.recv(1) != b"":
+        raise RuntimeError("request was not half-closed exactly")
+    return message_type, body, batch_id, request_id
+
+
+def response_header(message_type, body, batch_id, request_id):
+    return HEADER.pack(b"NXSG", 1, 0, message_type, 0, 0, len(body), batch_id, request_id)
+
+
+def describe_body(key_name, public_key, endpoint_id):
+    encoded_name = key_name.encode()
+    return struct.pack("!H", len(encoded_name)) + encoded_name + b"\x01" + public_key + endpoint_id
+
+
+def decode_sign_request(body, key_name, public_key, endpoint_id):
+    if len(body) < 2:
+        raise RuntimeError("short sign request")
+    name_length = struct.unpack("!H", body[:2])[0]
+    offset = 2
+    actual_name = body[offset : offset + name_length]
+    offset += name_length
+    actual_public_key = body[offset : offset + 32]
+    offset += 32
+    actual_endpoint_id = body[offset : offset + 16]
+    offset += 16
+    if len(body) < offset + 4:
+        raise RuntimeError("short sign fingerprint")
+    fingerprint_length = struct.unpack("!I", body[offset : offset + 4])[0]
+    offset += 4
+    fingerprint = body[offset : offset + fingerprint_length]
+    offset += fingerprint_length
+    if (
+        offset != len(body)
+        or actual_name != key_name.encode()
+        or actual_public_key != public_key
+        or actual_endpoint_id != endpoint_id
+    ):
+        raise RuntimeError("sign request did not pin described identity")
+    return fingerprint
+
+
+def sign_body(key_name, public_key, endpoint_id, signature):
+    encoded_name = key_name.encode()
+    return struct.pack("!H", len(encoded_name)) + encoded_name + public_key + endpoint_id + signature
+
+
+def write_state(path, requests):
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(json.dumps({"requests": requests}, indent=2) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def replace_listener(listener, path):
+    listener.close()
+    path.unlink()
+    replacement = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    replacement.bind(str(path))
+    os.chmod(path, 0o600)
+    replacement.listen()
+    return replacement
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--socket", type=Path, required=True)
+    parser.add_argument("--state", type=Path, required=True)
+    parser.add_argument("--key-name", required=True)
+    parser.add_argument("--seed", required=True)
+    parser.add_argument("--requests", type=int, default=2)
+    parser.add_argument(
+        "--mode",
+        choices=("good", "idle", "malformed", "bad-sign", "bad-second", "delay", "timeout", "outage", "replacement"),
+        default="good",
+    )
+    args = parser.parse_args()
+
+    seed = bytes.fromhex(args.seed)
+    if len(seed) != 32:
+        raise RuntimeError("seed must contain exactly 32 bytes")
+    library = load_sodium()
+    public_key, secret_key = keypair(library, seed)
+    endpoint_id = bytes.fromhex("0123456789abcdeffedcba9876543210")
+    args.socket.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    os.chmod(args.socket.parent, 0o700)
+    args.socket.unlink(missing_ok=True)
+    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    replacement = None
+    requests = []
+    sign_count = 0
+    try:
+        listener.bind(str(args.socket))
+        os.chmod(args.socket, 0o600)
+        listener.listen()
+        args.state.with_suffix(".public").write_text(
+            args.key_name + ":" + base64.b64encode(public_key).decode() + "\n", encoding="utf-8"
+        )
+        args.state.with_suffix(".ready").touch()
+        if args.mode == "idle":
+            while True:
+                time.sleep(60)
+        for _ in range(args.requests):
+            connection, _ = listener.accept()
+            with connection:
+                message_type, body, batch_id, request_id = read_request(connection)
+                request = {
+                    "type": message_type,
+                    "batch": batch_id.hex(),
+                    "request": request_id.hex(),
+                }
+                requests.append(request)
+                write_state(args.state, requests)
+                if message_type == DESCRIBE_REQUEST:
+                    if body:
+                        raise RuntimeError("DescribeKey body was not empty")
+                    response = describe_body(args.key_name, public_key, endpoint_id)
+                    connection.sendall(response_header(DESCRIBE_RESPONSE, response, batch_id, request_id) + response)
+                    if args.mode == "outage":
+                        listener.close()
+                        args.socket.unlink()
+                        break
+                    if args.mode == "replacement":
+                        replacement = replace_listener(listener, args.socket)
+                        break
+                    continue
+                fingerprint = decode_sign_request(body, args.key_name, public_key, endpoint_id)
+                request["fingerprint"] = fingerprint.decode()
+                write_state(args.state, requests)
+                sign_count += 1
+                if args.mode == "delay":
+                    time.sleep(1)
+                elif args.mode == "timeout":
+                    time.sleep(6)
+                if args.mode == "malformed":
+                    response = b"\x00"
+                else:
+                    signature = sign(library, secret_key, fingerprint)
+                    if args.mode == "bad-sign" or (args.mode == "bad-second" and sign_count == 2):
+                        signature = bytes(64)
+                    response = sign_body(args.key_name, public_key, endpoint_id, signature)
+                try:
+                    connection.sendall(response_header(SIGN_RESPONSE, response, batch_id, request_id) + response)
+                except BrokenPipeError:
+                    if args.mode not in ("delay", "timeout"):
+                        raise
+        if replacement is not None:
+            time.sleep(1)
+    finally:
+        listener.close()
+        if replacement is not None:
+            replacement.close()
+        args.socket.unlink(missing_ok=True)
+
+
+if __name__ == "__main__":
+    main()
