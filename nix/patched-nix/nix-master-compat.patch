+std::filesystem::path canonicalizeSocketPath(const std::filesystem::path & path)
+{
+#ifdef _WIN32
+    throw Error("NXSG 1.0 Unix sockets are unavailable on this platform");
+#else
+    if (path.empty() || path.filename().empty() || path.filename() == "." || path.filename() == "..")
+        throw Error("invalid NXSG 1.0 socket path");
+    std::filesystem::path parent;
+    try {
+        parent = std::filesystem::canonical(path.parent_path().empty() ? "." : path.parent_path());
+    } catch (const std::filesystem::filesystem_error & error) {
+        throw Error("cannot canonicalize NXSG 1.0 socket parent: %s", error.what());
+    }
+    const auto canonical = parent / path.filename();
+    static_cast<void>(validateSocketForConnect(canonical));
+    return canonical;
+#endif
+}
+
+Client::Client(const std::filesystem::path & socketPath, std::chrono::milliseconds deadline)
+    : socketPath(canonicalizeSocketPath(socketPath))
+    , deadline(deadline)
+    , batchId{}
+{
+    if (deadline <= std::chrono::milliseconds::zero() || deadline > std::chrono::seconds(5))
+        throw Error("NXSG 1.0 deadline must be greater than zero and at most five seconds");
+#ifndef _WIN32
+    const auto socketIdentity = validateSocketForConnect(this->socketPath);
+    socketDevice = socketIdentity.device;
+    socketInode = socketIdentity.inode;
+#endif
+    randombytes_buf(batchId.data(), batchId.size());
+    if (!validId(batchId))
+        batchId.front() = 1;
+}
+
+std::vector<uint8_t>
+Client::exchange(MessageType type, std::span<const uint8_t> body, Clock::time_point operationDeadline)
+{
+#ifdef _WIN32
+    throw Error("NXSG 1.0 Unix sockets are unavailable on this platform");
+#else
+    requireBeforeDeadline(operationDeadline);
+    std::array<uint8_t, 16> requestId{};
+    randombytes_buf(requestId.data(), requestId.size());
+    if (!validId(requestId))
+        requestId.front() = 1;
+    const Header requestHeader{
+        .type = type,
+        .status = Status::ok,
+        .bodySize = static_cast<uint32_t>(body.size()),
+        .batchId = batchId,
+        .requestId = requestId,
+    };
+    const auto encodedHeader = encodeHeader(requestHeader);
+    requireBeforeDeadline(operationDeadline);
+
+    auto socket = createClientSocket();
+    requireBeforeDeadline(operationDeadline);
+    const auto beforeConnect = validateSocketForConnect(socketPath);
+    if (beforeConnect.device != socketDevice || beforeConnect.inode != socketInode)
+        throw Error("NXSG 1.0 socket was replaced after client construction");
+    requireBeforeDeadline(operationDeadline);
+    connectWithDeadline(socket.get(), socketPath, operationDeadline);
+    const auto afterConnect = validateSocketForConnect(socketPath);
+    if (afterConnect != beforeConnect)
+        throw Error("NXSG 1.0 socket was replaced while connecting");
+    requireBeforeDeadline(operationDeadline);
+    requirePeerPath(socket.get(), socketPath, operationDeadline);
+    requireSameEffectiveUid(socket.get(), operationDeadline);
+    writeAll(socket.get(), encodedHeader, operationDeadline);
+    writeAll(socket.get(), body, operationDeadline);
+    shutdownWrite(socket.get(), operationDeadline);
+
+    std::array<uint8_t, headerSize> responseHeaderBytes{};
+    readExact(socket.get(), responseHeaderBytes, operationDeadline);
+    const auto responseHeader = decodeHeader(responseHeaderBytes);
+    const auto expectedType =
+        type == MessageType::describeKeyRequest ? MessageType::describeKeyResponse : MessageType::signPathInfoResponse;
+    if (responseHeader.type != expectedType || responseHeader.batchId != batchId
+        || responseHeader.requestId != requestId)
+        throw Error("NXSG 1.0 response type or correlation ID does not match the request");
+    std::vector<uint8_t> responseBody(responseHeader.bodySize);
+    readExact(socket.get(), responseBody, operationDeadline);
+    requireEof(socket.get(), operationDeadline);
+    if (Clock::now() >= operationDeadline)
+        deadlineError();
+    if (responseHeader.status != Status::ok)
+        throw ExternalSignerError(responseHeader.status, decodeErrorResponse(responseBody));
+    return responseBody;
+#endif
+}
+
+const DescribeKeyResponse & Client::describeKey()
+{
+    const auto operationDeadline = Clock::now() + deadline;
+    if (identity)
+        throw Error("NXSG 1.0 signer identity was already described");
+    auto request = encodeDescribeKeyRequest();
+    requireBeforeDeadline(operationDeadline);
+    auto response = decodeDescribeKeyResponse(exchange(MessageType::describeKeyRequest, request, operationDeadline));
+    commitIdentity(std::move(response), operationDeadline);
+    return *identity;
+}
+
+void Client::commitIdentity(DescribeKeyResponse response, Clock::time_point operationDeadline)
+{
+    requireBeforeDeadline(operationDeadline);
+    identity.emplace(std::move(response));
+}
+
+SignPathInfoResponse Client::signPathInfoV1(std::string_view fingerprint)
+{
+    const auto operationDeadline = Clock::now() + deadline;
+    if (!identity)
+        throw Error("NXSG 1.0 signer identity must be described before signing");
+    validatePathInfoV1(fingerprint);
+    requireBeforeDeadline(operationDeadline);
+    const auto requestBody = encodeSignPathInfoRequest(
+        SignPathInfoRequest{
+            .keyName = identity->keyName,
+            .publicKey = identity->publicKey,
+            .endpointId = identity->endpointId,
+            .fingerprint = std::string(fingerprint),
+        });
+    requireBeforeDeadline(operationDeadline);
+    auto response =
+        decodeSignPathInfoResponse(exchange(MessageType::signPathInfoRequest, requestBody, operationDeadline));
+    requireBeforeDeadline(operationDeadline);
+    if (response.keyName != identity->keyName || response.publicKey != identity->publicKey
+        || response.endpointId != identity->endpointId)
+        throw Error("NXSG 1.0 signer identity changed after DescribeKey");
+    requireBeforeDeadline(operationDeadline);
+    if (crypto_sign_verify_detached(
+            response.signature.data(),
+            reinterpret_cast<const unsigned char *>(fingerprint.data()),
+            fingerprint.size(),
+            identity->publicKey.data())
+        != 0)
+        throw Error("NXSG 1.0 signer returned an invalid Ed25519 signature");
+    requireBeforeDeadline(operationDeadline);
+    return response;
+}
+
+} // namespace nix::externalSigner
