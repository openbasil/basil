+void validatePathInfoV1(std::string_view fingerprint)
+{
+    if (fingerprint.empty() || fingerprint.size() > maxFingerprintSize)
+        throw Error("invalid PATH_INFO_V1 fingerprint length");
+    for (const auto raw : fingerprint) {
+        const auto byte = static_cast<unsigned char>(raw);
+        if (byte > 0x7f || byte < 0x20 || byte == 0x7f)
+            throw Error("invalid PATH_INFO_V1 non-ASCII or control byte");
+    }
+
+    const auto fields = splitFingerprint(fingerprint);
+    if (fields[0] != "1")
+        throw Error("invalid PATH_INFO_V1 profile version");
+    validateStorePath(fields[1]);
+    if (!fields[2].starts_with("sha256:") || fields[2].size() != 59 || !validNix32(fields[2].substr(7)))
+        throw Error("invalid PATH_INFO_V1 NAR hash");
+    if (fields[3].empty() || (fields[3].size() > 1 && fields[3].front() == '0')
+        || !std::ranges::all_of(fields[3], [](char character) { return character >= '0' && character <= '9'; }))
+        throw Error("invalid PATH_INFO_V1 NAR size syntax");
+    uint64_t narSize = 0;
+    const auto [end, error] = std::from_chars(fields[3].data(), fields[3].data() + fields[3].size(), narSize);
+    if (error != std::errc{} || end != fields[3].data() + fields[3].size() || narSize == 0)
+        throw Error("invalid PATH_INFO_V1 NAR size range");
+
+    if (!fields[4].empty()) {
+        size_t count = 0;
+        size_t start = 0;
+        std::string_view previous;
+        while (true) {
+            const auto separator = fields[4].find(',', start);
+            const auto reference = fields[4].substr(
+                start, separator == std::string_view::npos ? std::string_view::npos : separator - start);
+            if (++count > maxReferences)
+                throw Error("PATH_INFO_V1 reference count exceeds %d", maxReferences);
+            validateStorePath(reference);
+            if (!previous.empty() && previous >= reference)
+                throw Error("PATH_INFO_V1 references are duplicate or unsorted");
+            previous = reference;
+            if (separator == std::string_view::npos)
+                break;
+            start = separator + 1;
+        }
+    }
+}
