diff --git a/tests/functional/external-signing.sh b/tests/functional/external-signing.sh
new file mode 100644
index 0000000000000000000000000000000000000000..377be3175dd5c14de9bbc0c92daea13c60230ff1
--- /dev/null
+++ b/tests/functional/external-signing.sh
@@ -0,0 +1,191 @@
+#!/usr/bin/env bash
+
+source common.sh
+
+# NXSG's PATH_INFO_V1 profile deliberately signs canonical /nix/store paths.
+# Keep the test store isolated on disk while preserving that logical store dir.
+export NIX_STORE_DIR=/nix/store
+export NIX_REMOTE="local?root=$TEST_ROOT/external-store"
+
+helper="$functionalTestsDir/nix-cache-signing/external-signer.py"
+seed1=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
+seed2=202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f
+seed3=404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f
+signerPids=()
+
+cleanupSigners() {
+    for pid in "${signerPids[@]}"; do
+        if kill -0 "$pid" 2>/dev/null; then
+            kill "$pid" 2>/dev/null || true
+        fi
+        wait "$pid" 2>/dev/null || true
+    done
+}
+trap cleanupSigners EXIT
+
+startSigner() {
+    local id=$1
+    local keyName=$2
+    local seed=$3
+    local mode=${4:-good}
+    local requests=${5:-2}
+    signerDir="$TEST_ROOT/signers/$id"
+    signerSocket="$signerDir/signer.sock"
+    signerState="$signerDir/state.json"
+    mkdir -p "$signerDir"
+    chmod 0700 "$signerDir"
+    python3 "$helper" \
+        --socket "$signerSocket" \
+        --state "$signerState" \
+        --key-name "$keyName" \
+        --seed "$seed" \
+        --mode "$mode" \
+        --requests "$requests" &
+    signerPid=$!
+    signerPids+=("$signerPid")
+    for _ in {1..500}; do
+        if [[ -S "$signerSocket" && -e "${signerState%.json}.ready" ]]; then
+            return
+        fi
+        if ! kill -0 "$signerPid" 2>/dev/null; then
+            wait "$signerPid"
+            return 1
+        fi
+        sleep 0.01
+    done
+    echo "external signer $id did not become ready" >&2
+    return 1
+}
+
+assertUnsigned() {
+    nix path-info --json --json-format 2 "$@" | jq -e '.info.[] | .signatures == []'
+}
+
+printf 'external signing fixture one\n' > "$TEST_ROOT/fixture-one"
+printf 'external signing fixture two\n' > "$TEST_ROOT/fixture-two"
+outPath=$(nix store add-file "$TEST_ROOT/fixture-one")
+outPath2=$(nix store add-file "$TEST_ROOT/fixture-two")
+assertUnsigned "$outPath" "$outPath2"
+
+nix-store --generate-binary-cache-key local.example.org "$TEST_ROOT/local.sk" "$TEST_ROOT/local.pk"
+expect 1 nix store sign "$outPath"
+expect 1 nix store sign --key-file "$TEST_ROOT/local.sk" --signer-socket "$TEST_ROOT/absent.sock" "$outPath"
+assertUnsigned "$outPath"
+
+# Canonical aliases of one socket are duplicates and fail before DescribeKey.
+startSigner duplicate-path cache-path.example.org "$seed1" idle 0
+duplicatePid=$signerPid
+duplicateSocket=$signerSocket
+ln -s "$signerDir" "$TEST_ROOT/signer-alias"
+expect 1 nix store sign \
+    --signer-socket "$duplicateSocket" \
+    --signer-socket "$TEST_ROOT/signer-alias/signer.sock" \
+    "$outPath"
+kill "$duplicatePid"
+wait "$duplicatePid" || true
+assertUnsigned "$outPath"
+
+# Different sockets claiming one Nix key identity are rejected after one DescribeKey each.
+startSigner duplicate-key-a cache-duplicate.example.org "$seed1" good 1
+duplicateKeyPidA=$signerPid
+duplicateKeySocketA=$signerSocket
+duplicateKeyStateA=$signerState
+startSigner duplicate-key-b cache-duplicate.example.org "$seed2" good 1
+duplicateKeyPidB=$signerPid
+duplicateKeySocketB=$signerSocket
+duplicateKeyStateB=$signerState
+expect 1 nix store sign \
+    --signer-socket "$duplicateKeySocketA" \
+    --signer-socket "$duplicateKeySocketB" \
+    "$outPath"
+wait "$duplicateKeyPidA"
+wait "$duplicateKeyPidB"
+jq -e '.requests | map(.type) == [1]' "$duplicateKeyStateA"
+jq -e '.requests | map(.type) == [1]' "$duplicateKeyStateB"
+assertUnsigned "$outPath"
+
+# Malformed replies, bad signatures, outage, and socket replacement never mutate the store.
+for mode in malformed bad-sign outage replacement; do
+    startSigner "$mode" "cache-$mode.example.org" "$seed1" "$mode" 2
+    failurePid=$signerPid
+    failureSocket=$signerSocket
+    expect 1 nix store sign --signer-socket "$failureSocket" "$outPath"
+    wait "$failurePid"
+    assertUnsigned "$outPath"
+done
+
+# A failure on a later path verifies that all signatures are collected before mutation.
+startSigner atomic cache-atomic.example.org "$seed1" bad-second 3
+atomicPid=$signerPid
+atomicSocket=$signerSocket
+expect 1 nix store sign --signer-socket "$atomicSocket" "$outPath" "$outPath2"
+wait "$atomicPid"
+assertUnsigned "$outPath" "$outPath2"
+
+# Interrupting an in-flight request is observed before mutation.
+startSigner cancel cache-cancel.example.org "$seed1" delay 2
+cancelPid=$signerPid
+cancelSocket=$signerSocket
+nix store sign --signer-socket "$cancelSocket" "$outPath" &
+commandPid=$!
+sleep 0.2
+kill -INT "$commandPid"
+if wait "$commandPid"; then
+    echo "cancelled external signing unexpectedly succeeded" >&2
+    exit 1
+fi
+wait "$cancelPid"
+assertUnsigned "$outPath"
+
+# An unresponsive provider hits the fixed five-second end-to-end deadline.
+startSigner timeout cache-timeout.example.org "$seed1" timeout 2
+timeoutPid=$signerPid
+timeoutSocket=$signerSocket
+expect 1 nix store sign --signer-socket "$timeoutSocket" "$outPath"
+wait "$timeoutPid"
+assertUnsigned "$outPath"
+
+# Distinct repeatable providers sign successfully with one batch ID per socket.
+startSigner success-a cache-external-a.example.org "$seed1" good 2
+successPidA=$signerPid
+successSocketA=$signerSocket
+successStateA=$signerState
+successPublicA=${signerState%.json}.public
+startSigner success-b cache-external-b.example.org "$seed2" good 2
+successPidB=$signerPid
+successSocketB=$signerSocket
+successStateB=$signerState
+successPublicB=${signerState%.json}.public
+nix store sign --signer-socket "$successSocketA" --signer-socket "$successSocketB" "$outPath"
+wait "$successPidA"
+wait "$successPidB"
+nix store verify --sigs-needed 2 --trusted-public-keys "$(cat "$successPublicA") $(cat "$successPublicB")" "$outPath"
+
+for state in "$successStateA" "$successStateB"; do
+    jq -e '
+        (.requests | map(.type)) == [1, 2]
+        and (.requests | map(.batch) | unique | length) == 1
+        and (.requests | all(.batch | length == 32 and . != "00000000000000000000000000000000"))
+        and (.requests | map(.request) | unique | length) == 2
+        and (.requests | all(.request | length == 32 and . != "00000000000000000000000000000000"))
+    ' "$state"
+done
+
+# Existing key-file behavior remains usable.
+nix store sign --key-file "$TEST_ROOT/local.sk" "$outPath"
+nix store verify --sigs-needed 3 \
+    --trusted-public-keys "$(cat "$successPublicA") $(cat "$successPublicB") $(cat "$TEST_ROOT/local.pk")" \
+    "$outPath"
+
+# External signing mutates file-cache metadata through the existing store API.
+mkdir -p "$cacheDir"
+nix copy --to "file://$cacheDir" "$outPath"
+startSigner file-cache cache-external-file.example.org "$seed3" good 2
+fileCachePid=$signerPid
+fileCacheSocket=$signerSocket
+fileCachePublic=${signerState%.json}.public
+nix store sign --store "file://$cacheDir" --signer-socket "$fileCacheSocket" "$outPath"
+wait "$fileCachePid"
+nix store verify --store "file://$cacheDir" --sigs-needed 4 \
+    --trusted-public-keys "$(cat "$successPublicA") $(cat "$successPublicB") $(cat "$TEST_ROOT/local.pk") $(cat "$fileCachePublic")" \
+    "$outPath"
