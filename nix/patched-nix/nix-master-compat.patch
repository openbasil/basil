+TEST(external_signer, performsPinnedDescribeAndVerifiedSignExchanges)
+{
+    std::array<uint8_t, 32> publicKey{};
+    std::array<uint8_t, 64> secretKey{};
+    ASSERT_EQ(crypto_sign_keypair(publicKey.data(), secretKey.data()), 0);
+    const std::array<uint8_t, 16> endpointId{0x42};
+    const auto describeBody = encodeDescribeBody("cache", publicKey, endpointId);
+    TestServer server({
+        [describeBody](Descriptor connection, const Header & request, std::span<const uint8_t> body) {
+            EXPECT_EQ(request.type, MessageType::describeKeyRequest);
+            EXPECT_TRUE(body.empty());
+            sendResponse(connection, request, MessageType::describeKeyResponse, Status::ok, describeBody);
+        },
+        [publicKey, secretKey, endpointId](
+            Descriptor connection, const Header & request, std::span<const uint8_t> body) {
+            EXPECT_EQ(request.type, MessageType::signPathInfoRequest);
+            const auto decoded = decodeSignPathInfoRequest(body);
+            EXPECT_EQ(decoded.keyName, "cache");
+            EXPECT_EQ(decoded.publicKey, publicKey);
+            EXPECT_EQ(decoded.endpointId, endpointId);
+            EXPECT_EQ(decoded.fingerprint, canonicalFingerprint);
+            std::array<uint8_t, 64> signature{};
+            ASSERT_EQ(
+                crypto_sign_detached(
+                    signature.data(),
+                    nullptr,
+                    reinterpret_cast<const unsigned char *>(decoded.fingerprint.data()),
+                    decoded.fingerprint.size(),
+                    secretKey.data()),
+                0);
+            const auto response = encodeSignBody("cache", publicKey, endpointId, signature);
+            sendResponse(connection, request, MessageType::signPathInfoResponse, Status::ok, response);
+        },
+    });
+    Client client(server.path);
+    const auto & identity = client.describeKey();
+    EXPECT_EQ(identity.keyName, "cache");
+    EXPECT_THROW(client.describeKey(), Error);
+    const auto response = client.signPathInfoV1(canonicalFingerprint);
+    EXPECT_EQ(response.endpointId, endpointId);
+}
+
+TEST(external_signer, rejectsWrongCorrelationAndTrailingResponseBytes)
+{
+    std::array<uint8_t, 32> publicKey{0x11};
+    std::array<uint8_t, 16> endpointId{0x12};
+    const auto describeBody = encodeDescribeBody("cache", publicKey, endpointId);
+    TestServer wrongId({[describeBody](Descriptor connection, const Header & request, std::span<const uint8_t>) {
+        sendResponse(connection, request, MessageType::describeKeyResponse, Status::ok, describeBody, false, true);
+    }});
+    Client wrongIdClient(wrongId.path);
+    EXPECT_THROW(wrongIdClient.describeKey(), Error);
+
+    TestServer trailing({[describeBody](Descriptor connection, const Header & request, std::span<const uint8_t>) {
+        sendResponse(connection, request, MessageType::describeKeyResponse, Status::ok, describeBody, true);
+    }});
+    Client trailingClient(trailing.path);
+    EXPECT_THROW(trailingClient.describeKey(), Error);
+}
+
+TEST(external_signer, rejectsWrongResponseTypeAndEarlyEof)
+{
+    TestServer wrongType({[](Descriptor connection, const Header & request, std::span<const uint8_t>) {
+        const std::array<uint8_t, 0> body{};
+        sendResponse(connection, request, MessageType::signPathInfoResponse, Status::ok, body);
+    }});
+    Client wrongTypeClient(wrongType.path);
+    EXPECT_THROW(wrongTypeClient.describeKey(), Error);
+
+    TestServer earlyEof({[](Descriptor connection, const Header &, std::span<const uint8_t>) {
+        writeFull(connection, "NXSG", false);
+    }});
+    Client earlyEofClient(earlyEof.path);
+    EXPECT_THROW(earlyEofClient.describeKey(), Error);
+}
+
+TEST(external_signer, surfacesBoundedTypedErrorAndRejectsMalformedDiagnostic)
+{
+    TestServer typedError({[](Descriptor connection, const Header & request, std::span<const uint8_t>) {
+        const std::vector<uint8_t> body{0, 4, 'b', 'u', 's', 'y'};
+        sendResponse(connection, request, MessageType::describeKeyResponse, Status::overloaded, body);
+    }});
+    Client typedErrorClient(typedError.path);
+    try {
+        static_cast<void>(typedErrorClient.describeKey());
+        FAIL() << "expected typed signer error";
+    } catch (const ExternalSignerError & error) {
+        EXPECT_EQ(error.status, Status::overloaded);
+    }
+
+    TestServer malformed({[](Descriptor connection, const Header & request, std::span<const uint8_t>) {
+        const std::vector<uint8_t> body{0, 4, 'b'};
+        sendResponse(connection, request, MessageType::describeKeyResponse, Status::internal, body);
+    }});
+    Client malformedClient(malformed.path);
+    EXPECT_THROW(malformedClient.describeKey(), Error);
+}
+
+TEST(external_signer, enforcesOneEndToEndDeadline)
+{
+    TestServer delayed({[](Descriptor connection, const Header & request, std::span<const uint8_t>) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        const std::array<uint8_t, 0> body{};
+        sendResponse(connection, request, MessageType::describeKeyResponse, Status::ok, body);
+    }});
+    Client client(delayed.path, std::chrono::milliseconds(25));
+    EXPECT_THROW(client.describeKey(), Error);
+}
+
+TEST(external_signer, deadlineFailureBeforeIdentityCommitLeavesDescribeRetryable)
+{
+    std::array<uint8_t, 32> publicKey{};
+    std::array<uint8_t, 64> secretKey{};
+    ASSERT_EQ(crypto_sign_keypair(publicKey.data(), secretKey.data()), 0);
+    const std::array<uint8_t, 16> endpointId{0x42};
+    const auto describeBody = encodeDescribeBody("cache", publicKey, endpointId);
+    TestServer server({
+        [describeBody](Descriptor connection, const Header & request, std::span<const uint8_t>) {
+            sendResponse(connection, request, MessageType::describeKeyResponse, Status::ok, describeBody);
+        },
+        [publicKey, secretKey, endpointId](
+            Descriptor connection, const Header & request, std::span<const uint8_t> body) {
+            const auto decoded = decodeSignPathInfoRequest(body);
+            std::array<uint8_t, 64> signature{};
+            ASSERT_EQ(
+                crypto_sign_detached(
+                    signature.data(),
+                    nullptr,
+                    reinterpret_cast<const unsigned char *>(decoded.fingerprint.data()),
+                    decoded.fingerprint.size(),
+                    secretKey.data()),
+                0);
+            const auto response = encodeSignBody("cache", publicKey, endpointId, signature);
+            sendResponse(connection, request, MessageType::signPathInfoResponse, Status::ok, response);
+        },
+    });
+    Client client(server.path);
+    const DescribeKeyResponse identity{
+        .keyName = "cache",
+        .algorithm = ed25519Algorithm,
+        .publicKey = publicKey,
+        .endpointId = endpointId,
+    };
+
+    EXPECT_THROW(
+        ExternalSignerClientTestAccess::commitIdentity(
+            client, identity, std::chrono::steady_clock::now() - std::chrono::milliseconds(1)),
+        Error);
+    EXPECT_THROW(client.signPathInfoV1(canonicalFingerprint), Error);
+
+    EXPECT_EQ(client.describeKey().endpointId, endpointId);
+    EXPECT_EQ(client.signPathInfoV1(canonicalFingerprint).endpointId, endpointId);
+}
+
+TEST(external_signer, rejectsEndpointReplacementAfterDescribe)
+{
+    std::array<uint8_t, 32> publicKey{};
+    std::array<uint8_t, 64> secretKey{};
+    ASSERT_EQ(crypto_sign_keypair(publicKey.data(), secretKey.data()), 0);
+    const std::array<uint8_t, 16> firstEndpoint{0x11};
+    const std::array<uint8_t, 16> replacementEndpoint{0x22};
+    const auto describeBody = encodeDescribeBody("cache", publicKey, firstEndpoint);
+    TestServer server({
+        [describeBody](Descriptor connection, const Header & request, std::span<const uint8_t>) {
+            sendResponse(connection, request, MessageType::describeKeyResponse, Status::ok, describeBody);
+        },
+        [publicKey, secretKey, replacementEndpoint](
+            Descriptor connection, const Header & request, std::span<const uint8_t> body) {
+            const auto decoded = decodeSignPathInfoRequest(body);
+            std::array<uint8_t, 64> signature{};
+            ASSERT_EQ(
+                crypto_sign_detached(
+                    signature.data(),
+                    nullptr,
+                    reinterpret_cast<const unsigned char *>(decoded.fingerprint.data()),
+                    decoded.fingerprint.size(),
+                    secretKey.data()),
+                0);
+            const auto response = encodeSignBody("cache", publicKey, replacementEndpoint, signature);
+            sendResponse(connection, request, MessageType::signPathInfoResponse, Status::ok, response);
+        },
+    });
+    Client client(server.path);
+    static_cast<void>(client.describeKey());
+    EXPECT_THROW(client.signPathInfoV1(canonicalFingerprint), Error);
+}
+
+TEST(external_signer, rejectsInvalidReturnedSignature)
+{
+    const std::array<uint8_t, 32> publicKey{0x11};
+    const std::array<uint8_t, 16> endpointId{0x12};
+    const std::array<uint8_t, 64> signature{0x13};
+    const auto describeBody = encodeDescribeBody("cache", publicKey, endpointId);
+    const auto signBody = encodeSignBody("cache", publicKey, endpointId, signature);
+    TestServer server({
+        [describeBody](Descriptor connection, const Header & request, std::span<const uint8_t>) {
+            sendResponse(connection, request, MessageType::describeKeyResponse, Status::ok, describeBody);
+        },
+        [signBody](Descriptor connection, const Header & request, std::span<const uint8_t>) {
+            sendResponse(connection, request, MessageType::signPathInfoResponse, Status::ok, signBody);
+        },
+    });
+    Client client(server.path);
+    static_cast<void>(client.describeKey());
+    EXPECT_THROW(client.signPathInfoV1(canonicalFingerprint), Error);
+}
+
+#endif
+
+} // namespace nix::externalSigner
