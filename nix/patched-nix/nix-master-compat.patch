+void requirePeerPath(int fd, const std::filesystem::path & expectedPath, Clock::time_point deadline)
+{
+    requireBeforeDeadline(deadline);
+    struct sockaddr_un address{};
+    socklen_t length = sizeof(address);
+    while (getpeername(fd, reinterpret_cast<struct sockaddr *>(&address), &length) < 0) {
+        if (errno != EINTR)
+            throw SysError("reading NXSG 1.0 peer address");
+        if (Clock::now() >= deadline)
+            deadlineError();
+        length = sizeof(address);
+    }
+    requireBeforeDeadline(deadline);
+    constexpr auto pathOffset = offsetof(struct sockaddr_un, sun_path);
+    if (address.sun_family != AF_UNIX || length <= pathOffset)
+        throw Error("NXSG 1.0 peer did not report a pathname Unix address");
+    const auto available = std::min(static_cast<size_t>(length - pathOffset), sizeof(address.sun_path));
+    const auto actualLength = strnlen(address.sun_path, available);
+    if (actualLength == available || std::string_view(address.sun_path, actualLength) != expectedPath.string())
+        throw Error("NXSG 1.0 peer address does not match the validated socket path");
+    requireBeforeDeadline(deadline);
+}
