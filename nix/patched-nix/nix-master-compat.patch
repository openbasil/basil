+std::array<uint8_t, N> readFixed(std::span<const uint8_t> body, size_t & offset, std::string_view what)
+{
+    requireBytes(body, offset, N, what);
+    std::array<uint8_t, N> result{};
+    std::ranges::copy(body.subspan(offset, N), result.begin());
+    offset += N;
+    return result;
