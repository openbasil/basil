diff --git a/src/libutil/include/nix/util/signature/external-signer.hh b/src/libutil/include/nix/util/signature/external-signer.hh
new file mode 100644
index 0000000000000000000000000000000000000000..b78de65ba43f9b3de32283af9274a45765d0f0c0
--- /dev/null
+++ b/src/libutil/include/nix/util/signature/external-signer.hh
@@ -0,0 +1,168 @@
+#pragma once
+
+#include "nix/util/types.hh"
+#include "nix/util/error.hh"
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace nix::externalSigner {
+
+constexpr size_t headerSize = 48;
+constexpr uint32_t maxDescribeKeyResponseBodySize = 179;
+constexpr uint32_t maxErrorResponseBodySize = 1026;
+constexpr uint32_t maxSignPathInfoRequestBodySize = 524808;
+constexpr uint32_t maxSignPathInfoResponseBodySize = 242;
+constexpr uint32_t maxFingerprintSize = 524626;
+constexpr size_t maxReferences = 2048;
+constexpr uint8_t ed25519Algorithm = 1;
+
+enum class MessageType : uint8_t {
+    describeKeyRequest = 0x01,
+    describeKeyResponse = 0x81,
+    signPathInfoRequest = 0x02,
+    signPathInfoResponse = 0x82,
+};
+
+enum class Status : uint8_t {
+    ok = 0,
+    malformed = 1,
+    unsupportedVersion = 2,
+    unauthorized = 3,
+    keyMismatch = 4,
+    invalidFingerprint = 5,
+    unavailable = 6,
+    deadlineExceeded = 7,
+    internal = 8,
+    overloaded = 9,
+};
+
+struct Header
+{
+    MessageType type;
+    Status status;
+    uint32_t bodySize;
+    std::array<uint8_t, 16> batchId;
+    std::array<uint8_t, 16> requestId;
+};
+
+struct DescribeKeyResponse
+{
+    std::string keyName;
+    uint8_t algorithm;
+    std::array<uint8_t, 32> publicKey;
+    std::array<uint8_t, 16> endpointId;
+};
+
+struct SignPathInfoRequest
+{
+    std::string keyName;
+    std::array<uint8_t, 32> publicKey;
+    std::array<uint8_t, 16> endpointId;
+    std::string fingerprint;
+};
+
+struct SignPathInfoResponse
+{
+    std::string keyName;
+    std::array<uint8_t, 32> publicKey;
+    std::array<uint8_t, 16> endpointId;
+    std::array<uint8_t, 64> signature;
+};
+
+/** An error status returned by an external signer. */
+class ExternalSignerError final : public CloneableError<ExternalSignerError, Error>
+{
+public:
+    Status status;
+
+    ExternalSignerError(Status status, std::string diagnostic);
+};
+
+/** Encode one validated NXSG 1.0 header in network byte order. */
+std::array<uint8_t, headerSize> encodeHeader(const Header & header);
+
+/** Decode and validate one complete NXSG 1.0 header. */
+Header decodeHeader(std::span<const uint8_t, headerSize> bytes);
+
+/** Return whether an opaque protocol ID contains at least one non-zero byte. */
+bool validId(std::span<const uint8_t, 16> id) noexcept;
+
+/** Validate the empty `DescribeKeyRequest` body. */
+void validateDescribeKeyRequest(std::span<const uint8_t> body);
+
+/** Encode the empty `DescribeKeyRequest` body. */
+std::vector<uint8_t> encodeDescribeKeyRequest();
+
+/** Decode a successful `DescribeKeyResponse` body. */
+DescribeKeyResponse decodeDescribeKeyResponse(std::span<const uint8_t> body);
+
+/** Decode a `SignPathInfoV1Request` body with exact field lengths. */
+SignPathInfoRequest decodeSignPathInfoRequest(std::span<const uint8_t> body);
+
+/** Encode a validated `SignPathInfoV1Request` body. */
+std::vector<uint8_t> encodeSignPathInfoRequest(const SignPathInfoRequest & request);
+
+/** Decode a successful `SignPathInfoV1Response` body. */
+SignPathInfoResponse decodeSignPathInfoResponse(std::span<const uint8_t> body);
+
+/** Decode and validate a bounded non-success diagnostic body. */
+std::string decodeErrorResponse(std::span<const uint8_t> body);
+
+/** Validate one canonical `PATH_INFO_V1` fingerprint. */
+void validatePathInfoV1(std::string_view fingerprint);
+
+/**
+ * Canonicalize and validate a signer socket path without following its final
+ * component.
+ */
+std::filesystem::path canonicalizeSocketPath(const std::filesystem::path & path);
+
+/**
+ * Client for one key served by one `NXSG` 1.0 Unix socket.
+ *
+ * One client pins the identity returned by exactly one `DescribeKey` call.
+ * Every exchange uses a fresh connection and request ID under one command
+ * batch ID.
+ */
+class Client
+{
+public:
+    explicit Client(
+        const std::filesystem::path & socketPath, std::chrono::milliseconds deadline = std::chrono::seconds(5));
+
+    /** Discover and pin the signer identity. May be called exactly once. */
+    const DescribeKeyResponse & describeKey();
+
+    /** Validate and sign one canonical `PATH_INFO_V1` fingerprint. */
+    SignPathInfoResponse signPathInfoV1(std::string_view fingerprint);
+
+    /** Return the canonical socket pathname used by this client. */
+    const std::filesystem::path & path() const noexcept
+    {
+        return socketPath;
+    }
+
+private:
+    friend struct ExternalSignerClientTestAccess;
+
+    std::filesystem::path socketPath;
+    std::chrono::milliseconds deadline;
+    std::array<uint8_t, 16> batchId;
+    std::optional<DescribeKeyResponse> identity;
+    uintmax_t socketDevice = 0;
+    uintmax_t socketInode = 0;
+
+    std::vector<uint8_t>
+    exchange(MessageType type, std::span<const uint8_t> body, std::chrono::steady_clock::time_point operationDeadline);
+
+    void commitIdentity(DescribeKeyResponse response, std::chrono::steady_clock::time_point operationDeadline);
+};
+
+} // namespace nix::externalSigner
