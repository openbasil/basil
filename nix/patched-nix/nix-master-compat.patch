+TEST(external_signer, roundTripsNetworkHeader)
+{
+    Header input{
+        .type = MessageType::signPathInfoRequest,
+        .status = Status::ok,
+        .bodySize = 42,
+        .batchId = {1},
+        .requestId = {2},
+    };
+
+    auto encoded = encodeHeader(input);
+    EXPECT_EQ(encoded[0], 'N');
+    EXPECT_EQ(encoded[12], 0);
+    EXPECT_EQ(encoded[15], 42);
+    EXPECT_EQ(decodeHeader(encoded).bodySize, 42);
+    EXPECT_EQ(decodeHeader(encoded).type, input.type);
+    EXPECT_EQ(decodeHeader(encoded).batchId, input.batchId);
+}
