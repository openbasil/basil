+void sendWithoutSigPipe(Descriptor connection, std::span<const uint8_t> bytes)
+{
+#  if defined(SO_NOSIGPIPE) && !defined(MSG_NOSIGNAL)
+    constexpr int enabled = 1;
+    if (setsockopt(connection, SOL_SOCKET, SO_NOSIGPIPE, &enabled, sizeof(enabled)) < 0)
+        throw Error("test server could not disable SIGPIPE");
+#  elif !defined(MSG_NOSIGNAL)
+    throw Error("test platform cannot suppress SIGPIPE");
+#  endif
+    while (!bytes.empty()) {
+#  ifdef MSG_NOSIGNAL
+        const auto count = ::send(connection, bytes.data(), bytes.size(), MSG_NOSIGNAL);
+#  else
+        const auto count = ::send(connection, bytes.data(), bytes.size(), 0);
+#  endif
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count <= 0)
+            throw Error("test server could not write response");
+        bytes = bytes.subspan(static_cast<size_t>(count));
+    }
+}
+
+void sendResponse(
+    Descriptor connection,
+    const Header & request,
+    MessageType type,
+    Status status,
+    std::span<const uint8_t> body,
+    bool trailing = false,
+    bool wrongRequestId = false)
+{
+    auto requestId = request.requestId;
+    if (wrongRequestId)
+        requestId.front() ^= 0x80;
+    const auto header = encodeHeader(
+        Header{
+            .type = type,
+            .status = status,
+            .bodySize = static_cast<uint32_t>(body.size()),
+            .batchId = request.batchId,
+            .requestId = requestId,
+        });
+    sendWithoutSigPipe(connection, header);
+    sendWithoutSigPipe(connection, body);
+    if (trailing) {
+        constexpr std::array<uint8_t, 1> trailingByte{'x'};
+        sendWithoutSigPipe(connection, trailingByte);
+    }
+}
+
+#endif
