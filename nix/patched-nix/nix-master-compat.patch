+void connectWithDeadline(int fd, const std::filesystem::path & path, Clock::time_point deadline)
+{
+    struct sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    const auto nativePath = path.string();
+    if (nativePath.size() >= sizeof(address.sun_path))
+        throw Error("NXSG 1.0 socket path is too long: %s", PathFmt(path));
+    std::memcpy(address.sun_path, nativePath.c_str(), nativePath.size() + 1);
+    while (true) {
+        if (Clock::now() >= deadline)
+            deadlineError();
+        if (::connect(fd, reinterpret_cast<struct sockaddr *>(&address), sizeof(address)) == 0)
+            return;
+        const auto connectError = errno;
+        if (connectError == EINTR)
+            continue;
+        if (connectError == EISCONN)
+            return;
+        if (connectError != EINPROGRESS && connectError != EAGAIN && connectError != EALREADY) {
+            errno = connectError;
+            throw SysError("connecting to NXSG 1.0 socket %s", PathFmt(path));
+        }
+
+        while (true) {
+            waitFor(fd, POLLOUT, deadline);
+            int socketError = 0;
+            socklen_t length = sizeof(socketError);
+            int result;
+            do {
+                if (Clock::now() >= deadline)
+                    deadlineError();
+                length = sizeof(socketError);
+                result = getsockopt(fd, SOL_SOCKET, SO_ERROR, &socketError, &length);
+            } while (result < 0 && errno == EINTR);
+            if (result < 0)
+                throw SysError("checking NXSG 1.0 socket connection");
+            if (length != sizeof(socketError))
+                throw Error("NXSG 1.0 socket returned malformed connection status");
+            if (socketError == 0)
+                return;
+            if (socketError == EINPROGRESS || socketError == EAGAIN || socketError == EALREADY)
+                continue;
+            errno = socketError;
+            throw SysError("connecting to NXSG 1.0 socket %s", PathFmt(path));
+        }
+    }
+}
