+TEST(external_signer, validatesDescribeKeyBodies)
+{
+    validateDescribeKeyRequest(std::span<const uint8_t>{});
+    const std::array<uint8_t, 1> nonEmptyBody{0};
+    EXPECT_THROW(validateDescribeKeyRequest(nonEmptyBody), Error);
+
+    std::vector<uint8_t> body{0, 4, 'k', 'e', 'y', '1', ed25519Algorithm};
+    body.insert(body.end(), 32, 0x42);
+    body.insert(body.end(), 16, 0x43);
+    const auto response = decodeDescribeKeyResponse(body);
+    EXPECT_EQ(response.keyName, "key1");
+    EXPECT_EQ(response.algorithm, ed25519Algorithm);
+    EXPECT_EQ(response.publicKey[0], 0x42);
+
+    body.push_back(0);
+    EXPECT_THROW(decodeDescribeKeyResponse(body), Error);
+    body.pop_back();
+    body[6] = 2;
+    EXPECT_THROW(decodeDescribeKeyResponse(body), Error);
+
+    body[6] = ed25519Algorithm;
+    std::fill(body.begin() + 39, body.begin() + 55, 0);
+    EXPECT_THROW(decodeDescribeKeyResponse(body), Error);
+    body.resize(39);
+    EXPECT_THROW(decodeDescribeKeyResponse(body), Error);
+}
