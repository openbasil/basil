+AutoCloseFD createClientSocket()
+{
+    int type = SOCK_STREAM;
+#  ifdef SOCK_CLOEXEC
+    type |= SOCK_CLOEXEC;
+#  endif
+#  ifdef SOCK_NONBLOCK
+    type |= SOCK_NONBLOCK;
+#  endif
+    AutoCloseFD socket(toDescriptor(::socket(AF_UNIX, type, 0)));
+    if (!socket)
+        throw SysError("creating NXSG 1.0 socket");
+    unix::closeOnExec(socket.get());
+    const auto flags = fcntl(socket.get(), F_GETFL, 0);
+    if (flags < 0 || fcntl(socket.get(), F_SETFL, flags | O_NONBLOCK) < 0)
+        throw SysError("making NXSG 1.0 socket non-blocking");
+#  if defined(SO_NOSIGPIPE) && !defined(MSG_NOSIGNAL)
+    constexpr int enabled = 1;
+    if (setsockopt(socket.get(), SOL_SOCKET, SO_NOSIGPIPE, &enabled, sizeof(enabled)) < 0)
+        throw SysError("disabling SIGPIPE on NXSG 1.0 socket");
+#  elif !defined(MSG_NOSIGNAL)
+    throw Error("this platform cannot suppress SIGPIPE for NXSG 1.0 socket writes");
+#  endif
+    return socket;
+}
