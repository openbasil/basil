+TEST(external_signer, rejectsEveryUnknownTypeAndStatus)
+{
+    Header input{
+        .type = MessageType::describeKeyResponse,
+        .status = Status::ok,
+        .bodySize = 0,
+        .batchId = {1},
+        .requestId = {2},
+    };
+    const auto validType = [](uint8_t value) {
+        return value == 0x01 || value == 0x81 || value == 0x02 || value == 0x82;
+    };
+    for (unsigned int value = 0; value <= std::numeric_limits<uint8_t>::max(); ++value) {
+        if (validType(static_cast<uint8_t>(value)))
+            continue;
+        auto encoded = encodeHeader(input);
+        encoded[6] = static_cast<uint8_t>(value);
+        EXPECT_THROW(decodeHeader(encoded), Error) << "type " << value;
+    }
+    for (unsigned int value = 10; value <= std::numeric_limits<uint8_t>::max(); ++value) {
+        auto encoded = encodeHeader(input);
+        encoded[7] = static_cast<uint8_t>(value);
+        EXPECT_THROW(decodeHeader(encoded), Error) << "status " << value;
+    }
+
+    auto encoded = encodeHeader(input);
+    std::fill(encoded.begin() + 32, encoded.end(), 0);
+    EXPECT_THROW(decodeHeader(encoded), Error);
+    encoded = encodeHeader(input);
+    encoded[0] = 'B';
+    EXPECT_THROW(decodeHeader(encoded), Error);
+}
