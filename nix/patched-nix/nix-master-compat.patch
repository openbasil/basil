+TEST(external_signer, rejectsUntrustedOrSymlinkSocketPath)
+{
+    auto directory = createTempDir("", "nxsg-path", 0700);
+    AutoDelete deleteDirectory(directory, true);
+    const auto socketPath = directory / "signer.sock";
+    auto listener = createUnixDomainSocket(socketPath, 0600);
+    EXPECT_EQ(canonicalizeSocketPath(socketPath), socketPath);
+
+    const auto linkPath = directory / "link.sock";
+    ASSERT_EQ(symlink(socketPath.c_str(), linkPath.c_str()), 0);
+    EXPECT_THROW(canonicalizeSocketPath(linkPath), Error);
+
+    ASSERT_EQ(::chmod(socketPath.c_str(), 0660), 0);
+    EXPECT_THROW(canonicalizeSocketPath(socketPath), Error);
+    ASSERT_EQ(::chmod(socketPath.c_str(), 0600), 0);
+    ASSERT_EQ(::chmod(directory.c_str(), 0755), 0);
+    EXPECT_THROW(canonicalizeSocketPath(socketPath), Error);
+}
