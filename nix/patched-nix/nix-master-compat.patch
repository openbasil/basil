+void shutdownWrite(int fd, Clock::time_point deadline)
+{
+    requireBeforeDeadline(deadline);
+    while (shutdown(fd, SHUT_WR) < 0) {
+        if (errno != EINTR)
+            throw SysError("half-closing NXSG 1.0 request");
+        if (Clock::now() >= deadline)
+            deadlineError();
+    }
+    requireBeforeDeadline(deadline);
+}
