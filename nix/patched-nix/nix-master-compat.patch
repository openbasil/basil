+bool validId(std::span<const uint8_t, 16> id) noexcept
+{
+    return std::ranges::any_of(id, [](uint8_t byte) { return byte != 0; });
+}
+
+std::array<uint8_t, headerSize> encodeHeader(const Header & header)
+{
+    if (!validType(static_cast<uint8_t>(header.type)) || !validStatus(static_cast<uint8_t>(header.status))
+        || (static_cast<uint8_t>(header.type) < 0x80 && header.status != Status::ok)
+        || header.bodySize > bodySizeLimit(header.type, header.status) || !validId(header.batchId)
+        || !validId(header.requestId))
+        throw Error("invalid NXSG 1.0 header");
+
+    std::array<uint8_t, headerSize> bytes{};
+    std::ranges::copy(magic, bytes.begin());
+    bytes[4] = 1;
+    bytes[5] = 0;
+    bytes[6] = static_cast<uint8_t>(header.type);
+    bytes[7] = static_cast<uint8_t>(header.status);
+    writeU32(bytes, 8, 0);
+    writeU32(bytes, 12, header.bodySize);
+    std::ranges::copy(header.batchId, bytes.begin() + 16);
+    std::ranges::copy(header.requestId, bytes.begin() + 32);
+    return bytes;
+}
+
+Header decodeHeader(std::span<const uint8_t, headerSize> bytes)
+{
+    if (!std::ranges::equal(std::span{bytes}.subspan<0, 4>(), magic) || bytes[4] != 1 || bytes[5] != 0
+        || !validType(bytes[6]) || !validStatus(bytes[7]) || (bytes[6] < 0x80 && bytes[7] != 0)
+        || readU32(bytes, 8) != 0
+        || readU32(bytes, 12) > bodySizeLimit(static_cast<MessageType>(bytes[6]), static_cast<Status>(bytes[7])))
+        throw Error("invalid NXSG 1.0 header");
+
+    Header header{
+        .type = static_cast<MessageType>(bytes[6]),
+        .status = static_cast<Status>(bytes[7]),
+        .bodySize = readU32(bytes, 12),
+    };
+    std::ranges::copy(bytes.subspan<16, 16>(), header.batchId.begin());
+    std::ranges::copy(bytes.subspan<32, 16>(), header.requestId.begin());
+    if (!validId(header.batchId) || !validId(header.requestId))
+        throw Error("NXSG 1.0 header contains an all-zero ID");
+    return header;
+}
