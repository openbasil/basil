+uid_t peerUid(int fd, Clock::time_point deadline)
+{
+#  if defined(SO_PEERCRED)
+#    if defined(__OpenBSD__)
+    struct sockpeercred credentials{};
+#    else
+    struct ucred credentials{};
+#    endif
+    while (true) {
+        if (Clock::now() >= deadline)
+            deadlineError();
+        socklen_t length = sizeof(credentials);
+        if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &credentials, &length) == 0) {
+            requireBeforeDeadline(deadline);
+            if (length != sizeof(credentials))
+                throw Error("NXSG 1.0 socket returned malformed peer credentials");
+            return credentials.uid;
+        }
+        if (errno != EINTR)
+            throw SysError("reading NXSG 1.0 peer credentials");
+    }
+#  elif defined(LOCAL_PEERCRED)
+#    if !defined(SOL_LOCAL)
+#      define SOL_LOCAL 0
+#    endif
+    struct xucred credentials{};
+    while (true) {
+        if (Clock::now() >= deadline)
+            deadlineError();
+        socklen_t length = sizeof(credentials);
+        if (getsockopt(fd, SOL_LOCAL, LOCAL_PEERCRED, &credentials, &length) == 0) {
+            requireBeforeDeadline(deadline);
+            if (length != sizeof(credentials))
+                throw Error("NXSG 1.0 socket returned malformed peer credentials");
+            return credentials.cr_uid;
+        }
+        if (errno != EINTR)
+            throw SysError("reading NXSG 1.0 peer credentials");
+    }
+#  elif defined(__APPLE__) || defined(__FreeBSD__)
+    uid_t uid = 0;
+    gid_t gid = 0;
+    while (true) {
+        if (Clock::now() >= deadline)
+            deadlineError();
+        if (getpeereid(fd, &uid, &gid) == 0) {
+            requireBeforeDeadline(deadline);
+            return uid;
+        }
+        if (errno != EINTR)
+            throw SysError("reading NXSG 1.0 peer credentials");
+    }
+#  else
+    throw Error("this platform has no trusted Unix peer-credential primitive for NXSG 1.0");
+#  endif
+}
+
+void requireSameEffectiveUid(int fd, Clock::time_point deadline)
+{
+    const auto uid = peerUid(fd, deadline);
+    requireBeforeDeadline(deadline);
+    if (uid != geteuid())
+        throw Error("NXSG 1.0 peer effective UID does not match the client");
+    requireBeforeDeadline(deadline);
+}
