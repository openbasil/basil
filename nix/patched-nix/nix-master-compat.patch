+std::array<std::string_view, 5> splitFingerprint(std::string_view fingerprint)
+{
+    std::array<std::string_view, 5> fields{};
+    size_t start = 0;
+    for (size_t index = 0; index < fields.size() - 1; ++index) {
+        const auto separator = fingerprint.find(';', start);
+        if (separator == std::string_view::npos)
+            throw Error("invalid PATH_INFO_V1 field count");
+        fields[index] = fingerprint.substr(start, separator - start);
+        start = separator + 1;
+    }
+    if (fingerprint.find(';', start) != std::string_view::npos)
+        throw Error("invalid PATH_INFO_V1 field count");
+    fields.back() = fingerprint.substr(start);
+    return fields;
+}
