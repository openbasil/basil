+void writeAll(int fd, std::span<const uint8_t> bytes, Clock::time_point deadline)
+{
+    while (!bytes.empty()) {
+        if (Clock::now() >= deadline)
+            deadlineError();
+#  ifdef MSG_NOSIGNAL
+        const auto count = send(fd, bytes.data(), bytes.size(), MSG_NOSIGNAL);
+#  else
+        const auto count = send(fd, bytes.data(), bytes.size(), 0);
+#  endif
+        if (count > 0) {
+            bytes = bytes.subspan(static_cast<size_t>(count));
+            continue;
+        }
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            waitFor(fd, POLLOUT, deadline);
+            continue;
+        }
+        throw SysError("writing NXSG 1.0 request");
+    }
+}
+
+void readExact(int fd, std::span<uint8_t> bytes, Clock::time_point deadline)
+{
+    while (!bytes.empty()) {
+        if (Clock::now() >= deadline)
+            deadlineError();
+        const auto count = recv(fd, bytes.data(), bytes.size(), 0);
+        if (count > 0) {
+            bytes = bytes.subspan(static_cast<size_t>(count));
+            continue;
+        }
+        if (count == 0)
+            throw EndOfFile("early EOF reading NXSG 1.0 response");
+        if (errno == EINTR)
+            continue;
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            waitFor(fd, POLLIN, deadline);
+            continue;
+        }
+        throw SysError("reading NXSG 1.0 response");
+    }
+}
+
+void requireEof(int fd, Clock::time_point deadline)
+{
+    uint8_t trailing = 0;
+    while (true) {
+        if (Clock::now() >= deadline)
+            deadlineError();
+        const auto count = recv(fd, &trailing, 1, 0);
+        if (count == 0)
+            return;
+        if (count > 0)
+            throw Error("NXSG 1.0 response contains trailing bytes");
+        if (errno == EINTR)
+            continue;
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            waitFor(fd, POLLIN, deadline);
+            continue;
+        }
+        throw SysError("checking NXSG 1.0 response EOF");
+    }
+}
