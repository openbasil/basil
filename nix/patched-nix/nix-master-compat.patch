+SocketIdentity validateSocketForConnect(const std::filesystem::path & path)
+{
+    struct stat parentStatus{};
+    const auto parent = path.parent_path();
+    if (::stat(parent.c_str(), &parentStatus) < 0)
+        throw SysError("checking NXSG 1.0 socket parent %s", PathFmt(parent));
+    if (!S_ISDIR(parentStatus.st_mode) || parentStatus.st_uid != geteuid() || (parentStatus.st_mode & 0077) != 0)
+        throw Error("NXSG 1.0 socket parent is not an owner-only directory owned by the effective UID");
+
+    struct stat socketStatus{};
+    if (lstat(path.c_str(), &socketStatus) < 0)
+        throw SysError("checking NXSG 1.0 socket %s", PathFmt(path));
+    if (S_ISLNK(socketStatus.st_mode))
+        throw Error("NXSG 1.0 socket path must not be a symlink");
+    if (!S_ISSOCK(socketStatus.st_mode) || socketStatus.st_uid != geteuid() || (socketStatus.st_mode & 0077) != 0)
+        throw Error("NXSG 1.0 socket is not an owner-only socket owned by the effective UID");
+    return {
+        .device = static_cast<uintmax_t>(socketStatus.st_dev),
+        .inode = static_cast<uintmax_t>(socketStatus.st_ino),
+    };
+}
