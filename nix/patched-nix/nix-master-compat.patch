+bool validNix32(std::string_view value) noexcept
+{
+    return std::ranges::all_of(value, [](char character) { return nix32Alphabet.contains(character); });
+}
+
+void validateStorePath(std::string_view path)
+{
+    if (!path.starts_with(storePrefix))
+        throw Error("invalid PATH_INFO_V1 store path prefix");
+    const auto base = path.substr(storePrefix.size());
+    if (base.size() < 34 || base[32] != '-' || !validNix32(base.substr(0, 32)))
+        throw Error("invalid PATH_INFO_V1 store path shape");
+    const auto name = base.substr(33);
+    if (name.empty() || name.size() > 211)
+        throw Error("invalid PATH_INFO_V1 store path name length");
+    if (name == "." || name == ".." || name.starts_with(".-") || name.starts_with("..-"))
+        throw Error("invalid PATH_INFO_V1 reserved store path name");
+    for (const auto character : name) {
+        const bool alphaNumeric = (character >= '0' && character <= '9') || (character >= 'a' && character <= 'z')
+                                  || (character >= 'A' && character <= 'Z');
+        if (!alphaNumeric && !std::string_view{"+-._?="}.contains(character))
+            throw Error("invalid PATH_INFO_V1 store path name character");
+    }
+}
