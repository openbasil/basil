+
+int remainingMilliseconds(Clock::time_point deadline)
+{
+    const auto now = Clock::now();
+    if (now >= deadline)
+        deadlineError();
+    const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now);
+    if (remaining.count() >= std::numeric_limits<int>::max())
+        return std::numeric_limits<int>::max();
+    return std::max(1, static_cast<int>(remaining.count()));
+}
+
+void waitFor(int fd, short events, Clock::time_point deadline)
+{
+    while (true) {
+        struct pollfd pollFd{
+            .fd = fd,
+            .events = events,
+            .revents = 0,
+        };
+        const auto result = poll(&pollFd, 1, remainingMilliseconds(deadline));
+        if (result == 0)
+            deadlineError();
+        if (result < 0) {
+            if (errno == EINTR)
+                continue;
+            throw SysError("polling NXSG 1.0 socket");
+        }
+        if (pollFd.revents & POLLNVAL)
+            throw Error("NXSG 1.0 socket became invalid");
+        if (pollFd.revents & (events | POLLERR | POLLHUP))
+            return;
+    }
+}
