new file mode 100644
index 0000000000000000000000000000000000000000..f99248f97a0cc5a1fdc12fa32d85b17fd71dd5b1
--- /dev/null
+++ b/src/libutil/signature/external-signer.cc
@@ -0,0 +1,907 @@
+#include "nix/util/signature/external-signer.hh"
+
+#include "nix/util/error.hh"
+#include "nix/util/file-descriptor.hh"
+#include "nix/util/signature/local-keys.hh"
+
+#include <algorithm>
+#include <charconv>
+#include <cerrno>
+#include <chrono>
+#include <cstddef>
+#include <cstring>
+#include <limits>
+#include <ranges>
+#include <string_view>
+#include <system_error>
+
+#include <sodium.h>
+
+#ifndef _WIN32
+#  include <fcntl.h>
+#  include <poll.h>
+#  include <sys/socket.h>
+#  include <sys/stat.h>
+#  include <sys/types.h>
+#  include <sys/un.h>
+#  include <unistd.h>
+#  if defined(__APPLE__) || defined(__FreeBSD__)
+#    include <sys/ucred.h>
+#  endif
+#endif
+
+namespace nix::externalSigner {
+
+namespace {
+
+constexpr std::array<uint8_t, 4> magic{'N', 'X', 'S', 'G'};
+constexpr std::string_view nix32Alphabet = "0123456789abcdfghijklmnpqrsvwxyz";
+constexpr std::string_view storePrefix = "/nix/store/";
+
+bool validType(uint8_t value) noexcept
+{
+    return value == static_cast<uint8_t>(MessageType::describeKeyRequest)
+           || value == static_cast<uint8_t>(MessageType::describeKeyResponse)
+           || value == static_cast<uint8_t>(MessageType::signPathInfoRequest)
+           || value == static_cast<uint8_t>(MessageType::signPathInfoResponse);
+}
+
+bool validStatus(uint8_t value) noexcept
+{
+    return value <= static_cast<uint8_t>(Status::overloaded);
+}
+
+constexpr uint32_t bodySizeLimit(MessageType type, Status status) noexcept
+{
+    if (status != Status::ok)
+        return maxErrorResponseBodySize;
+
+    switch (type) {
+    case MessageType::describeKeyRequest:
+        return 0;
+    case MessageType::describeKeyResponse:
+        return maxDescribeKeyResponseBodySize;
+    case MessageType::signPathInfoRequest:
+        return maxSignPathInfoRequestBodySize;
+    case MessageType::signPathInfoResponse:
+        return maxSignPathInfoResponseBodySize;
+    }
+    return 0;
+}
+
+uint32_t readU32(std::span<const uint8_t, headerSize> bytes, size_t offset) noexcept
+{
+    return (static_cast<uint32_t>(bytes[offset]) << 24) | (static_cast<uint32_t>(bytes[offset + 1]) << 16)
+           | (static_cast<uint32_t>(bytes[offset + 2]) << 8) | static_cast<uint32_t>(bytes[offset + 3]);
+}
+
+void writeU32(std::span<uint8_t, headerSize> bytes, size_t offset, uint32_t value) noexcept
+{
+    bytes[offset] = static_cast<uint8_t>(value >> 24);
+    bytes[offset + 1] = static_cast<uint8_t>(value >> 16);
+    bytes[offset + 2] = static_cast<uint8_t>(value >> 8);
+    bytes[offset + 3] = static_cast<uint8_t>(value);
+}
+
+uint16_t readU16(std::span<const uint8_t> bytes, size_t offset) noexcept
+{
+    return static_cast<uint16_t>((static_cast<uint16_t>(bytes[offset]) << 8) | bytes[offset + 1]);
+}
+
+void appendU16(std::vector<uint8_t> & bytes, uint16_t value)
+{
+    bytes.push_back(static_cast<uint8_t>(value >> 8));
+    bytes.push_back(static_cast<uint8_t>(value));
+}
+
+void appendU32(std::vector<uint8_t> & bytes, uint32_t value)
+{
+    bytes.push_back(static_cast<uint8_t>(value >> 24));
+    bytes.push_back(static_cast<uint8_t>(value >> 16));
+    bytes.push_back(static_cast<uint8_t>(value >> 8));
+    bytes.push_back(static_cast<uint8_t>(value));
+}
+
+[[noreturn]] void invalidBody(std::string_view what)
+{
+    throw Error("invalid NXSG 1.0 %s body", what);
+}
+
+void requireBytes(std::span<const uint8_t> body, size_t offset, size_t count, std::string_view what)
+{
+    if (offset > body.size() || count > body.size() - offset)
+        invalidBody(what);
+}
+
+bool validText(std::span<const uint8_t> bytes) noexcept
+{
+    size_t index = 0;
+    while (index < bytes.size()) {
+        uint32_t codePoint = bytes[index++];
+        size_t continuation = 0;
+        if (codePoint < 0x80) {
+        } else if (codePoint >= 0xc2 && codePoint <= 0xdf) {
+            continuation = 1;
+            codePoint &= 0x1f;
+        } else if (codePoint >= 0xe0 && codePoint <= 0xef) {
+            continuation = 2;
+            codePoint &= 0x0f;
+        } else if (codePoint >= 0xf0 && codePoint <= 0xf4) {
+            continuation = 3;
+            codePoint &= 0x07;
+        } else {
+            return false;
+        }
+        if (continuation > bytes.size() - index)
+            return false;
+        for (size_t i = 0; i < continuation; ++i) {
+            const auto byte = bytes[index++];
+            if ((byte & 0xc0) != 0x80)
+                return false;
+            codePoint = (codePoint << 6) | (byte & 0x3f);
+        }
+        if ((continuation == 2 && codePoint < 0x800) || (continuation == 3 && codePoint < 0x10000)
+            || codePoint > 0x10ffff || (codePoint >= 0xd800 && codePoint <= 0xdfff))
+            return false;
+        if (codePoint < 0x20 || (codePoint >= 0x7f && codePoint <= 0x9f))
+            return false;
+    }
+    return true;
+}
+
+std::string readKeyName(std::span<const uint8_t> body, size_t & offset)
+{
+    requireBytes(body, offset, 2, "key identity");
+    const auto length = readU16(body, offset);
+    offset += 2;
+    requireBytes(body, offset, length, "key identity");
+    const auto bytes = body.subspan(offset, length);
+    offset += length;
+    if (bytes.empty() || bytes.size() > 128 || !validText(bytes))
+        invalidBody("key identity");
+    for (size_t i = 0; i < bytes.size(); ++i) {
+        const auto byte = bytes[i];
+        const bool first = i == 0;
+        if ((first && !((byte >= 'A' && byte <= 'Z') || (byte >= 'a' && byte <= 'z') || (byte >= '0' && byte <= '9')))
+            || (!first
+                && !(
+                    (byte >= 'A' && byte <= 'Z') || (byte >= 'a' && byte <= 'z') || (byte >= '0' && byte <= '9')
+                    || byte == '.' || byte == '_' || byte == '-')))
+            invalidBody("key identity");
+    }
+    return {reinterpret_cast<const char *>(bytes.data()), bytes.size()};
+}
+
+void appendKeyName(std::vector<uint8_t> & body, std::string_view keyName)
+{
+    if (keyName.empty() || keyName.size() > 128)
+        invalidBody("key identity");
+    std::vector<uint8_t> encoded;
+    encoded.reserve(keyName.size() + 2);
+    appendU16(encoded, static_cast<uint16_t>(keyName.size()));
+    encoded.insert(encoded.end(), keyName.begin(), keyName.end());
+    size_t offset = 0;
+    if (readKeyName(encoded, offset) != keyName || offset != encoded.size())
+        invalidBody("key identity");
+    body.insert(body.end(), encoded.begin(), encoded.end());
+}
