@@ -0,0 +1,404 @@
+#!/usr/bin/env python3
+
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+
+NIX32 = "0123456789abcdfghijklmnpqrsvwxyz"
+MAX_FINGERPRINT_LENGTH = 524_626
+MAX_REFERENCES = 2_048
+MAX_STORE_NAME_LENGTH = 211
+U64_MAX = 18_446_744_073_709_551_615
+RULE = "sequential-max-store-path-references-v1"
+REQUIRED_COVERAGE = {
+    "duplicate-references",
+    "empty-references",
+    "extra-field",
+    "invalid-nix32",
+    "invalid-reference",
+    "malformed-nar-hash",
+    "malformed-nar-size",
+    "malformed-references",
+    "malformed-store-path",
+    "malformed-version",
+    "max-references-accepted",
+    "max-references-rejected",
+    "maximum-length-accepted",
+    "maximum-length-rejected",
+    "missing-field",
+    "nar-size-one",
+    "nar-size-zero",
+    "non-fingerprint-input",
+    "populated-references",
+    "realisation-json",
+    "self-reference",
+    "size-leading-zero",
+    "size-plus-sign",
+    "size-u64-overflow",
+    "size-whitespace",
+    "store-empty-name",
+    "store-illegal-base32",
+    "store-name-over-211",
+    "store-wrong-prefix",
+    "unsorted-references",
+    "uppercase-nix32",
+    "wrong-digest-length",
+}
+
+
+class InvalidCorpus(ValueError):
+    pass
+
+
+class InvalidFingerprint(ValueError):
+    pass
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise InvalidCorpus(message)
+
+
+def exact_keys(value: dict, expected: set[str], where: str) -> None:
+    actual = set(value)
+    require(actual == expected, f"{where}: keys {sorted(actual)} != {sorted(expected)}")
+
+
+def unique_object(pairs: list[tuple[str, object]]) -> dict:
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise InvalidCorpus(f"duplicate JSON key: {key}")
+        result[key] = value
+    return result
+
+
+def decode_hex(value: object, where: str) -> bytes:
+    require(isinstance(value, str), f"{where}: hex value is not a string")
+    require(
+        re.fullmatch(r"(?:[0-9a-f]{2})*", value) is not None,
+        f"{where}: invalid lowercase hex",
+    )
+    return bytes.fromhex(value)
+
+
+def validate_store_path(value: str) -> str:
+    prefix = "/nix/store/"
+    if not value.startswith(prefix):
+        raise InvalidFingerprint("wrong store prefix")
+    base = value[len(prefix) :]
+    if len(base) < 34 or base[32] != "-":
+        raise InvalidFingerprint("invalid store-path shape")
+    hash_part = base[:32]
+    name = base[33:]
+    if any(character not in NIX32 for character in hash_part):
+        raise InvalidFingerprint("invalid store-path Nix32 hash")
+    if not 1 <= len(name) <= MAX_STORE_NAME_LENGTH:
+        raise InvalidFingerprint("invalid store-path name length")
+    if any(
+        not (character.isascii() and (character.isalnum() or character in "+-._?="))
+        for character in name
+    ):
+        raise InvalidFingerprint("invalid store-path name character")
+    if name in {".", ".."} or name.startswith((".-", "..-")):
+        raise InvalidFingerprint("reserved store-path name")
+    canonical = prefix + hash_part + "-" + name
+    if canonical != value:
+        raise InvalidFingerprint("noncanonical store path")
+    return canonical
+
+
+def parse_fingerprint(data: bytes) -> bytes:
+    if not 1 <= len(data) <= MAX_FINGERPRINT_LENGTH:
+        raise InvalidFingerprint("fingerprint length")
+    try:
+        text = data.decode("ascii")
+    except UnicodeDecodeError as error:
+        raise InvalidFingerprint("fingerprint is not ASCII") from error
+    if any(ord(character) < 0x20 or ord(character) == 0x7F for character in text):
+        raise InvalidFingerprint("fingerprint contains a control byte")
+    fields = text.split(";")
+    if len(fields) != 5:
+        raise InvalidFingerprint("fingerprint field count")
+    version, store_path, nar_hash, nar_size, references_field = fields
+    if version != "1":
+        raise InvalidFingerprint("profile version")
+    store_path = validate_store_path(store_path)
+    if not nar_hash.startswith("sha256:"):
+        raise InvalidFingerprint("NAR hash algorithm")
+    digest = nar_hash[7:]
+    if len(digest) != 52 or any(character not in NIX32 for character in digest):
+        raise InvalidFingerprint("NAR hash Nix32 digest")
+    if not nar_size or not nar_size.isascii() or not nar_size.isdecimal():
+        raise InvalidFingerprint("NAR size syntax")
+    if len(nar_size) > 1 and nar_size[0] == "0":
+        raise InvalidFingerprint("NAR size leading zero")
+    size = int(nar_size)
+    if not 1 <= size <= U64_MAX:
+        raise InvalidFingerprint("NAR size range")
+    references = [] if references_field == "" else references_field.split(",")
+    if len(references) > MAX_REFERENCES:
+        raise InvalidFingerprint("reference count")
+    canonical_references = [validate_store_path(reference) for reference in references]
+    if len(set(canonical_references)) != len(canonical_references):
+        raise InvalidFingerprint("duplicate references")
+    if canonical_references != sorted(canonical_references):
+        raise InvalidFingerprint("unsorted references")
+    canonical = ";".join(
+        [
+            "1",
+            store_path,
+            "sha256:" + digest,
+            str(size),
+            ",".join(canonical_references),
+        ]
+    ).encode("ascii")
+    if canonical != data:
+        raise InvalidFingerprint("noncanonical fingerprint")
+    return canonical
+
+
+def encode_counter(value: int, alphabet: str, width: int) -> str:
+    digits = []
+    for _ in range(width):
+        digits.append(alphabet[value % len(alphabet)])
+        value //= len(alphabet)
+    require(value == 0, "construction: reference counter exceeds its width")
+    return "".join(reversed(digits))
+
+
+def expand_construction(construction: object, where: str) -> bytes:
+    require(isinstance(construction, dict), f"{where}: construction is not an object")
+    exact_keys(construction, {"rule", "parameters"}, where)
+    require(construction["rule"] == RULE, f"{where}: unknown generator rule")
+    parameters = construction["parameters"]
+    require(isinstance(parameters, dict), f"{where}: parameters are not an object")
+    exact_keys(
+        parameters,
+        {
+            "last_reference_name_length",
+            "nar_hash",
+            "nar_size",
+            "reference_count",
+            "reference_hash_alphabet",
+            "reference_hash_counter_start",
+            "reference_hash_counter_width",
+            "reference_hash_prefix",
+            "reference_name_byte",
+            "reference_name_length",
+            "store_hash",
+            "store_name_byte",
+            "store_name_length",
+            "version",
+        },
+        f"{where}.parameters",
+    )
+    alphabet = parameters["reference_hash_alphabet"]
+    prefix = parameters["reference_hash_prefix"]
+    width = parameters["reference_hash_counter_width"]
+    start = parameters["reference_hash_counter_start"]
+    count = parameters["reference_count"]
+    require(alphabet == NIX32, f"{where}: generator alphabet is not canonical Nix32")
+    require(
+        isinstance(prefix, str) and set(prefix) <= set(NIX32),
+        f"{where}: invalid hash prefix",
+    )
+    require(isinstance(width, int) and width > 0, f"{where}: invalid counter width")
+    require(len(prefix) + width == 32, f"{where}: reference hash is not 32 bytes")
+    require(isinstance(start, int) and start >= 0, f"{where}: invalid counter start")
+    require(
+        isinstance(count, int) and 1 <= count <= 4_096,
+        f"{where}: invalid reference count",
+    )
+    store_hash = parameters["store_hash"]
+    store_name_byte = parameters["store_name_byte"]
+    store_name_length = parameters["store_name_length"]
+    reference_name_byte = parameters["reference_name_byte"]
+    reference_name_length = parameters["reference_name_length"]
+    last_reference_name_length = parameters["last_reference_name_length"]
+    for label, byte in (("store", store_name_byte), ("reference", reference_name_byte)):
+        require(
+            isinstance(byte, str) and len(byte) == 1 and byte.isascii(),
+            f"{where}: {label} name byte",
+        )
+    for label, length in (
+        ("store", store_name_length),
+        ("reference", reference_name_length),
+        ("last reference", last_reference_name_length),
+    ):
+        require(
+            isinstance(length, int) and 1 <= length <= 212,
+            f"{where}: {label} name length",
+        )
+    require(
+        isinstance(store_hash, str) and len(store_hash) == 32,
+        f"{where}: store hash length",
+    )
+    require(set(store_hash) <= set(NIX32), f"{where}: store hash alphabet")
+    nar_hash = parameters["nar_hash"]
+    nar_size = parameters["nar_size"]
+    version = parameters["version"]
+    require(isinstance(nar_hash, str), f"{where}: NAR hash is not text")
+    require(isinstance(nar_size, str), f"{where}: NAR size is not text")
+    require(isinstance(version, str), f"{where}: version is not text")
+    references = []
+    for offset in range(count):
+        counter = encode_counter(start + offset, alphabet, width)
+        name_length = (
+            last_reference_name_length if offset == count - 1 else reference_name_length
+        )
+        references.append(
+            "/nix/store/" + prefix + counter + "-" + reference_name_byte * name_length
+        )
+    return (
+        version
+        + ";/nix/store/"
+        + store_hash
+        + "-"
+        + store_name_byte * store_name_length
+        + ";sha256:"
+        + nar_hash
+        + ";"
+        + nar_size
+        + ";"
+        + ",".join(references)
+    ).encode("ascii")
+
+
+def validate_digest(fixture: Path, digests: Path) -> None:
+    entries = {}
+    for line in digests.read_text(encoding="ascii").splitlines():
+        if not line:
+            continue
+        match = re.fullmatch(r"([0-9a-f]{64})  ([A-Za-z0-9._-]+)", line)
+        require(match is not None, f"DIGESTS: malformed line: {line!r}")
+        digest, name = match.groups()
+        require(name not in entries, f"DIGESTS: duplicate entry for {name}")
+        entries[name] = digest
+    require(fixture.name in entries, f"DIGESTS: missing {fixture.name}")
+    actual = hashlib.sha256(fixture.read_bytes()).hexdigest()
+    require(entries[fixture.name] == actual, f"DIGESTS: {fixture.name} is {actual}")
+
+
+def validate_vector(vector: object, index: int) -> tuple[str, set[str]]:
+    where = f"vectors[{index}]"
+    require(isinstance(vector, dict), f"{where}: vector is not an object")
+    name = vector.get("name")
+    result = vector.get("result")
+    covers = vector.get("covers")
+    require(isinstance(name, str) and name, f"{where}: invalid name")
+    require(result in {"accept", "reject"}, f"{where}: invalid result")
+    require(isinstance(covers, list) and covers, f"{where}: invalid coverage list")
+    require(
+        all(isinstance(item, str) and item for item in covers),
+        f"{where}: invalid coverage label",
+    )
+    require(len(set(covers)) == len(covers), f"{where}: duplicate coverage label")
+    if "input" in vector:
+        expected = {"name", "result", "covers", "input"}
+        if result == "accept":
+            expected.add("canonical")
+        exact_keys(vector, expected, where)
+        data = decode_hex(vector["input"], f"{where}.input")
+        canonical = (
+            decode_hex(vector["canonical"], f"{where}.canonical")
+            if result == "accept"
+            else None
+        )
+    else:
+        expected = {
+            "construction",
+            "covers",
+            "input_length",
+            "input_sha256",
+            "name",
+            "result",
+        }
+        if result == "accept":
+            expected |= {"canonical_length", "canonical_sha256"}
+        exact_keys(vector, expected, where)
+        data = expand_construction(vector["construction"], f"{where}.construction")
+        require(
+            vector["input_length"] == len(data), f"{where}: constructed input length"
+        )
+        actual_digest = hashlib.sha256(data).hexdigest()
+        require(
+            vector["input_sha256"] == actual_digest,
+            f"{where}: constructed input digest",
+        )
+        canonical = data if result == "accept" else None
+        if result == "accept":
+            require(
+                vector["canonical_length"] == len(canonical),
+                f"{where}: canonical length",
+            )
+            require(
+                vector["canonical_sha256"] == hashlib.sha256(canonical).hexdigest(),
+                f"{where}: canonical digest",
+            )
+    if result == "accept":
+        parsed = parse_fingerprint(data)
+        require(parsed == canonical, f"{where}: canonical bytes differ")
+    else:
+        try:
+            parse_fingerprint(data)
+        except InvalidFingerprint:
+            pass
+        else:
+            raise InvalidCorpus(f"{where}: rejected vector was accepted")
+    return name, set(covers)
+
+
+def main() -> int:
+    if len(sys.argv) != 3:
+        print(f"usage: {sys.argv[0]} PATH-INFO-V1.json DIGESTS", file=sys.stderr)
+        return 2
+    fixture = Path(sys.argv[1])
+    digests = Path(sys.argv[2])
+    try:
+        validate_digest(fixture, digests)
+        corpus = json.loads(
+            fixture.read_text(encoding="utf-8"),
+            object_pairs_hook=unique_object,
+        )
+        require(isinstance(corpus, dict), "corpus: top level is not an object")
+        exact_keys(
+            corpus, {"generator_rules", "profile", "vectors", "version"}, "corpus"
+        )
+        require(corpus["version"] == 1, "corpus: version is not 1")
+        require(corpus["profile"] == "PATH_INFO_V1", "corpus: wrong profile")
+        require(corpus["generator_rules"] == [RULE], "corpus: wrong generator rules")
+        vectors = corpus["vectors"]
+        require(isinstance(vectors, list) and vectors, "corpus: vectors are empty")
+        names = set()
+        coverage = set()
+        accepted = 0
+        for index, vector in enumerate(vectors):
+            name, vector_coverage = validate_vector(vector, index)
+            require(name not in names, f"corpus: duplicate vector name: {name}")
+            names.add(name)
+            coverage |= vector_coverage
+            accepted += vector["result"] == "accept"
+        missing = REQUIRED_COVERAGE - coverage
+        require(not missing, f"corpus: missing coverage: {sorted(missing)}")
+    except (
+        InvalidCorpus,
+        InvalidFingerprint,
+        OSError,
+        UnicodeError,
+        json.JSONDecodeError,
+    ) as error:
+        print(f"nix-cache-signing-corpus: {error}", file=sys.stderr)
+        return 1
+    print(
+        f"PATH_INFO_V1 corpus: {len(vectors)} vectors "
+        f"({accepted} accept, {len(vectors) - accepted} reject), "
+        f"{len(coverage)} coverage labels"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
