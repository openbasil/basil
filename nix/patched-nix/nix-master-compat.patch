+TEST(external_signer, validatesTypedErrorBodyExactly)
+{
+    const std::vector<uint8_t> valid{0, 4, 'b', 'u', 's', 'y'};
+    EXPECT_EQ(decodeErrorResponse(valid), "busy");
+    const std::vector<uint8_t> validUtf8{0, 7, 'b', 'u', 's', 'y', 0xe2, 0x82, 0xac};
+    EXPECT_EQ(decodeErrorResponse(validUtf8).size(), 7);
+    auto invalid = valid;
+    invalid.push_back(0);
+    EXPECT_THROW(decodeErrorResponse(invalid), Error);
+    invalid = {0, 1, 0};
+    EXPECT_THROW(decodeErrorResponse(invalid), Error);
+    invalid = {0, 3, 0xe0, 0x80, 0x80};
+    EXPECT_THROW(decodeErrorResponse(invalid), Error);
+    invalid = {0, 3, 0xed, 0xa0, 0x80};
+    EXPECT_THROW(decodeErrorResponse(invalid), Error);
+    invalid = {0, 2, 0xc2, 0x9b};
+    EXPECT_THROW(decodeErrorResponse(invalid), Error);
+    invalid = {0, 2, 0x1b, '['};
+    EXPECT_THROW(decodeErrorResponse(invalid), Error);
+    invalid = {0, 2, 0xc0, 0x80};
+    EXPECT_THROW(decodeErrorResponse(invalid), Error);
+}
