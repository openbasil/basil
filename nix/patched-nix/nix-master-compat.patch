+using ServerHandler = std::function<void(Descriptor, const Header &, std::span<const uint8_t>)>;
+
+struct TestServer
+{
+    std::filesystem::path directory = createTempDir("", "nxsg-test", 0700);
+    AutoDelete deleteDirectory{directory, true};
+    std::filesystem::path path = directory / "signer.sock";
+    AutoCloseFD listener = createUnixDomainSocket(path, 0600);
+    std::thread thread;
+
+    explicit TestServer(std::vector<ServerHandler> handlers)
+        : thread([this, handlers = std::move(handlers)] {
+            try {
+                for (const auto & handler : handlers) {
+                    AutoCloseFD connection(accept(listener.get(), nullptr, nullptr));
+                    if (!connection)
+                        return;
+                    std::array<uint8_t, headerSize> headerBytes{};
+                    readFull(connection.get(), reinterpret_cast<char *>(headerBytes.data()), headerBytes.size());
+                    const auto header = decodeHeader(headerBytes);
+                    std::vector<uint8_t> body(header.bodySize);
+                    readFull(connection.get(), reinterpret_cast<char *>(body.data()), body.size());
+                    char extra = 0;
+                    if (read(connection.get(), {reinterpret_cast<std::byte *>(&extra), 1}) != 0)
+                        return;
+                    handler(connection.get(), header, body);
+                }
+            } catch (...) {
+                // Negative client tests deliberately close while the fake
+                // peer is still writing or waiting.
+            }
+        })
+    {
+    }
+
+    ~TestServer()
+    {
+        join();
+    }
+
+    void join()
+    {
+        if (thread.joinable())
+            thread.join();
+    }
+};
