+TEST(external_signer, validatesNormativePathInfoV1Corpus)
+{
+    const auto * corpusPath = std::getenv("_NIX_TEST_EXTERNAL_SIGNER_CORPUS");
+    ASSERT_NE(corpusPath, nullptr);
+    std::ifstream input(corpusPath);
+    ASSERT_TRUE(input.good());
+    const auto corpus = nlohmann::json::parse(input);
+    ASSERT_EQ(corpus.at("profile"), "PATH_INFO_V1");
+    for (const auto & vector : corpus.at("vectors")) {
+        const auto name = vector.at("name").get<std::string>();
+        SCOPED_TRACE(name);
+        std::string fingerprint;
+        if (vector.contains("input")) {
+            const auto bytes = decodeHex(vector.at("input").get<std::string>());
+            fingerprint.assign(reinterpret_cast<const char *>(bytes.data()), bytes.size());
+        } else {
+            fingerprint = expandConstruction(vector.at("construction"));
+            EXPECT_EQ(fingerprint.size(), vector.at("input_length").get<size_t>());
+        }
+        if (vector.at("result") == "accept") {
+            EXPECT_NO_THROW(validatePathInfoV1(fingerprint));
+            if (vector.contains("canonical")) {
+                const auto canonical = decodeHex(vector.at("canonical").get<std::string>());
+                EXPECT_EQ(fingerprint, std::string(reinterpret_cast<const char *>(canonical.data()), canonical.size()));
+            }
+        } else {
+            EXPECT_THROW(validatePathInfoV1(fingerprint), Error);
+        }
+    }
+}
