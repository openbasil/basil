+parseCommand :: [Prelude.String] -> ParserResult (Flags, CachixCommand)
+parseCommand = execParserPure defaultPrefs (optsInfo "/tmp/cachix-test.dhall")
+
+emptyConfig :: Config.Config
+emptyConfig =
+  Config.Config
+    { Config.authToken = Token "",
+      Config.hostname = URI.defaultCachixURI,
+      Config.binaryCaches = []
+    }
+
+isCredentialConflict :: Either Text PushSecret -> Bool
+isCredentialConflict = \case
+  Left message -> "mutually exclusive" `Text.isInfixOf` message
+  Right _ -> False
+
+withEnvironment :: Prelude.String -> Maybe Prelude.String -> IO a -> IO a
+withEnvironment name value = bracket (lookupEnv name <* install value) install . const
+  where
+    install = maybe (unsetEnv name) (setEnv name)
+
+cacheWithKeys :: [Text] -> BinaryCache.BinaryCache
+cacheWithKeys keys =
+  BinaryCache.BinaryCache
+    { BinaryCache.name = "example",
+      BinaryCache.uri = "https://example.cachix.org",
+      BinaryCache.isPublic = False,
+      BinaryCache.publicSigningKeys = keys,
+      BinaryCache.githubUsername = "",
+      BinaryCache.permission = Permission.Write,
+      BinaryCache.preferredCompressionMethod = BinaryCache.ZSTD
+    }
+
+externalIdentity :: ByteString -> ByteString -> Text
+externalIdentity keyName publicKey = decodeUtf8 keyName <> ":" <> decodeUtf8 (B64.encode publicKey)
+
+isExternalFailure :: CachixException -> Bool
+isExternalFailure (ExternalSignerError _) = True
+isExternalFailure _ = False
+
+isEndpointChanged :: CachixException -> Bool
+isEndpointChanged (ExternalSignerError message) =
+  message == "NXSG signer endpoint changed during the command"
+isEndpointChanged _ = False
+
+withScenario ::
+  Scenario ->
+  (FilePath -> Async.Async () -> ByteString -> ByteString -> ByteString -> IO a) ->
+  IO a
+withScenario scenario action =
+  withSystemTempDirectory "cachix-nxsg-conformance" $ \directory -> do
+    let socketPath = directory <> "/signer.sock"
+        keyName = "cache.example-1"
+        endpointId = BS.replicate 16 3
+    (PublicKey publicKey, secretKey) <- createKeypair
+    server <- startScenarioServer socketPath scenario keyName publicKey endpointId secretKey
+    action socketPath server keyName publicKey endpointId
+
+startScenarioServer ::
+  FilePath ->
+  Scenario ->
+  ByteString ->
+  ByteString ->
+  ByteString ->
+  SecretKey ->
+  IO (Async.Async ())
+startScenarioServer socketPath scenario keyName publicKey endpointId secretKey = do
+  listener <- boundListener socketPath
+  Async.async $ do
+    (describeSocket, _) <- accept listener
+    (_, describeBatch, describeRequest, describeRequestBody) <- receiveRequest describeSocket
+    unless (BS.null describeRequestBody) $ expectationFailure "DescribeKey request body was not empty"
+    let validDescribeBody = describeBody keyName publicKey endpointId
+        wrongBatch = corruptIdentifier describeBatch
+        wrongRequest = corruptIdentifier describeRequest
+    case scenario of
+      BadMagic -> sendResponsePreamble describeSocket "NOPE" 1 0 0x81 0 0 Nothing describeBatch describeRequest validDescribeBody mempty
+      WrongMajor -> sendResponsePreamble describeSocket "NXSG" 2 0 0x81 0 0 Nothing describeBatch describeRequest validDescribeBody mempty
+      WrongMinor -> sendResponsePreamble describeSocket "NXSG" 1 1 0x81 0 0 Nothing describeBatch describeRequest validDescribeBody mempty
+      WrongBatch -> sendResponse describeSocket 0x81 0 0 Nothing wrongBatch describeRequest validDescribeBody mempty
+      WrongRequest -> sendResponse describeSocket 0x81 0 0 Nothing describeBatch wrongRequest validDescribeBody mempty
+      WrongType -> sendResponse describeSocket 0x82 0 0 Nothing describeBatch describeRequest validDescribeBody mempty
+      InvalidStatus -> sendResponse describeSocket 0x81 10 0 Nothing describeBatch describeRequest mempty mempty
+      ProviderStatus -> sendResponse describeSocket 0x81 9 0 Nothing describeBatch describeRequest (diagnosticBody "busy") mempty
+      NonzeroFlags -> sendResponse describeSocket 0x81 0 1 Nothing describeBatch describeRequest validDescribeBody mempty
+      MaxBodyLength -> sendResponse describeSocket 0x81 0 0 (Just maxBound) describeBatch describeRequest mempty mempty
+      TruncatedBody ->
+        sendResponse
+          describeSocket
+          0x81
+          0
+          0
+          (Just $ fromIntegral $ BS.length validDescribeBody + 1)
+          describeBatch
+          describeRequest
+          validDescribeBody
+          mempty
+      TrailingBody -> sendResponse describeSocket 0x81 0 0 Nothing describeBatch describeRequest validDescribeBody "x"
+      Deadline -> threadDelay 6000000
+      MalformedDiagnostic -> sendResponse describeSocket 0x81 8 0 Nothing describeBatch describeRequest "\NUL\SOH\255" mempty
+      InvalidAlgorithm -> sendResponse describeSocket 0x81 0 0 Nothing describeBatch describeRequest (describeBodyWith 2 keyName publicKey endpointId) mempty
+      ZeroEndpoint -> sendResponse describeSocket 0x81 0 0 Nothing describeBatch describeRequest (describeBody keyName publicKey $ BS.replicate 16 0) mempty
+      _ -> sendResponse describeSocket 0x81 0 0 Nothing describeBatch describeRequest validDescribeBody mempty
+    close describeSocket
+
+    unless (isDescribeFailure scenario || scenario == DescribeOnly) $ do
+      (signSocket, _) <- accept listener
+      (_, signBatch, signRequest, signRequestBody) <- receiveRequest signSocket
+      fingerprint <- parseFingerprint signRequestBody
+      let responseName = if scenario == ChangedName then keyName <> "-rotated" else keyName
+          responsePublicKey = if scenario == ChangedPublicKey then BS.replicate 32 4 else publicKey
+          responseEndpoint = if scenario == ChangedEndpoint then BS.replicate 16 4 else endpointId
+          Signature validSignature = dsign secretKey fingerprint
+          signature = if scenario == MalformedSignature then BS.take 63 validSignature else validSignature
+          responseBody = signBody responseName responsePublicKey responseEndpoint signature
+      sendResponse signSocket 0x82 0 0 Nothing signBatch signRequest responseBody mempty
+      close signSocket
+    close listener
+
+withReplacementScenario ::
+  (FilePath -> Async.Async () -> MVar.MVar () -> MVar.MVar () -> IO a) ->
+  IO a
+withReplacementScenario action =
+  withSystemTempDirectory "cachix-nxsg-replacement" $ \directory -> do
+    let socketPath = directory <> "/signer.sock"
+        keyName = "cache.example-1"
+        endpointId = BS.replicate 16 3
+    (PublicKey publicKey, secretKey) <- createKeypair
+    replacementReady <- MVar.newEmptyMVar
+    requestObserved <- MVar.newEmptyMVar
+    bracket
+      (startReplacementServer socketPath keyName publicKey endpointId secretKey replacementReady requestObserved)
+      Async.cancel
+      (\server -> action socketPath server replacementReady requestObserved)
+
+startReplacementServer ::
+  FilePath ->
+  ByteString ->
+  ByteString ->
+  ByteString ->
+  SecretKey ->
+  MVar.MVar () ->
+  MVar.MVar () ->
+  IO (Async.Async ())
+startReplacementServer socketPath keyName publicKey endpointId secretKey replacementReady requestObserved = do
+  originalListener <- boundListener socketPath
+  Async.async $
+    bracket (pure originalListener) close $ \listener -> do
+      bracket (accept listener) (close . fst) $ \(describeSocket, _) -> do
+        (requestType, describeBatch, describeRequest, describeRequestBody) <- receiveRequest describeSocket
+        requestType `shouldBe` 0x01
+        describeRequestBody `shouldBe` mempty
+        sendResponse describeSocket 0x81 0 0 Nothing describeBatch describeRequest (describeBody keyName publicKey endpointId) mempty
+
+      removeFile socketPath
+      bracket (boundListener socketPath) close $ \replacementListener -> do
+        MVar.putMVar replacementReady ()
+        bracket (accept replacementListener) (close . fst) $ \(signSocket, _) -> do
+          (requestType, signBatch, signRequest, signRequestBody) <- receiveRequest signSocket
+          requestType `shouldBe` 0x02
+          fingerprint <- parseFingerprint signRequestBody
+          MVar.putMVar requestObserved ()
+          let replacementEndpoint = BS.replicate 16 4
+              Signature signature = dsign secretKey fingerprint
+              responseBody = signBody keyName publicKey replacementEndpoint signature
+          sendResponse signSocket 0x82 0 0 Nothing signBatch signRequest responseBody mempty
+
+awaitSignal :: Prelude.String -> MVar.MVar () -> IO ()
+awaitSignal failureMessage signal =
+  Timeout.timeout 2000000 (MVar.takeMVar signal) >>= \case
+    Nothing -> expectationFailure failureMessage
+    Just () -> pure ()
+
+awaitServer :: Async.Async () -> IO ()
+awaitServer server =
+  Timeout.timeout 2000000 (Async.waitCatch server) >>= \case
+    Nothing -> expectationFailure "replacement signer did not complete"
+    Just (Left exception) -> throwIO exception
+    Just (Right ()) -> pure ()
+
+isDescribeFailure :: Scenario -> Bool
+isDescribeFailure scenario =
+  scenario
+    `elem` [ BadMagic,
+             WrongMajor,
+             WrongMinor,
+             WrongBatch,
+             WrongRequest,
+             WrongType,
+             InvalidStatus,
+             ProviderStatus,
+             NonzeroFlags,
+             MaxBodyLength,
+             TruncatedBody,
+             TrailingBody,
+             Deadline,
+             MalformedDiagnostic,
+             InvalidAlgorithm,
+             ZeroEndpoint
+           ]
+
+boundListener :: FilePath -> IO Socket
+boundListener socketPath = do
+  listener <- socket AF_UNIX Stream defaultProtocol
+  bind listener $ SockAddrUnix socketPath
+  listen listener 2
+  pure listener
+
+describeBody :: ByteString -> ByteString -> ByteString -> ByteString
+describeBody keyName publicKey endpointId =
+  describeBodyWith 1 keyName publicKey endpointId
+
+describeBodyWith :: Word8 -> ByteString -> ByteString -> ByteString -> ByteString
+describeBodyWith algorithm keyName publicKey endpointId =
+  LBS.toStrict $ runPut $ do
+    putWord16be $ fromIntegral $ BS.length keyName
+    putByteString keyName
+    putWord8 algorithm
+    putByteString publicKey
+    putByteString endpointId
+
+signBody :: ByteString -> ByteString -> ByteString -> ByteString -> ByteString
+signBody keyName publicKey endpointId signature =
+  LBS.toStrict $ runPut $ do
+    putWord16be $ fromIntegral $ BS.length keyName
+    putByteString keyName
+    putByteString publicKey
+    putByteString endpointId
+    putByteString signature
+
+diagnosticBody :: ByteString -> ByteString
+diagnosticBody diagnostic =
+  LBS.toStrict $ runPut $ do
+    putWord16be $ fromIntegral $ BS.length diagnostic
+    putByteString diagnostic
+
+sendResponse ::
+  Socket ->
+  Word8 ->
+  Word8 ->
+  Word32 ->
+  Maybe Word32 ->
+  ByteString ->
+  ByteString ->
+  ByteString ->
+  ByteString ->
+  IO ()
+sendResponse sock responseType status flags declaredLength batchId requestId body trailing =
+  sendResponsePreamble sock "NXSG" 1 0 responseType status flags declaredLength batchId requestId body trailing
+
+sendResponsePreamble ::
+  Socket ->
+  ByteString ->
+  Word8 ->
+  Word8 ->
+  Word8 ->
+  Word8 ->
+  Word32 ->
+  Maybe Word32 ->
+  ByteString ->
+  ByteString ->
+  ByteString ->
+  ByteString ->
+  IO ()
+sendResponsePreamble sock magic major minor responseType status flags declaredLength batchId requestId body trailing =
+  Socket.sendAll sock $
+    LBS.toStrict (runPut header)
+      <> body
+      <> trailing
+  where
+    header = do
+      putByteString magic
+      putWord8 major
+      putWord8 minor
+      putWord8 responseType
+      putWord8 status
+      putWord32be flags
+      putWord32be $ fromMaybe (fromIntegral $ BS.length body) declaredLength
+      putByteString batchId
+      putByteString requestId
+
+receiveRequest :: Socket -> IO (Word8, ByteString, ByteString, ByteString)
+receiveRequest sock = do
+  header <- receiveExactly sock 48
+  let requestType = BS.index header 6
+      bodyLength = fromIntegral $ runGet getWord32be $ LBS.fromStrict $ BS.take 4 $ BS.drop 12 header
+      batchId = BS.take 16 $ BS.drop 16 header
+      requestId = BS.take 16 $ BS.drop 32 header
+  body <- receiveExactly sock bodyLength
+  trailing <- Socket.recv sock 1
+  unless (BS.null trailing) $ expectationFailure "request contained trailing bytes"
+  pure (requestType, batchId, requestId, body)
+
+parseFingerprint :: ByteString -> IO ByteString
+parseFingerprint encoded =
+  case runGetOrFail parser $ LBS.fromStrict encoded of
+    Left (_, _, reason) -> expectationFailure reason >> pure mempty
+    Right (remaining, _, fingerprint) -> do
+      unless (LBS.null remaining) $ expectationFailure "SignPathInfoV1 request contained trailing bytes"
+      pure fingerprint
+  where
+    parser = do
+      keyNameLength <- fromIntegral <$> getWord16be
+      skip keyNameLength
+      skip 32
+      skip 16
+      fingerprintLength <- fromIntegral <$> getWord32be
+      getByteString fingerprintLength
+
+receiveExactly :: Socket -> Int -> IO ByteString
+receiveExactly sock expected = go expected []
+  where
+    go 0 chunks = pure $ BS.concat $ reverse chunks
+    go remaining chunks = do
+      chunk <- Socket.recv sock remaining
+      if BS.null chunk
+        then expectationFailure "truncated NXSG request" >> pure mempty
+        else go (remaining - BS.length chunk) (chunk : chunks)
+
+corruptIdentifier :: ByteString -> ByteString
+corruptIdentifier identifier =
+  case BS.uncons identifier of
+    Nothing -> identifier
+    Just (firstByte, rest) -> BS.cons (if firstByte == 0 then 1 else 0) rest
