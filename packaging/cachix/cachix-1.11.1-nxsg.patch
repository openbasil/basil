+module Cachix.Client.ExternalSigner
+  ( ExternalSigner,
+    connectExternalSigner,
+    externalSignerPublicKey,
+    signFingerprint,
+  )
+where
+
+import Cachix.Client.Exception (CachixException (ExternalSignerError))
+import Control.Exception.Safe (bracket, throwIO)
+import Control.Monad.Fail qualified as MonadFail
+import Crypto.Random (getRandomBytes)
+import Crypto.Sign.Ed25519 (PublicKey (PublicKey), Signature (Signature), dverify)
+import Data.Binary.Get hiding (label, remaining)
+import Data.Binary.Put
+import Data.ByteString qualified as BS
+import Data.ByteString.Base64 qualified as B64
+import Data.ByteString.Lazy qualified as LBS
+import Data.Text qualified as Text
+import Data.Text.Encoding qualified as T
+import Network.Socket
+import Network.Socket.ByteString qualified as Socket
+import Protolude hiding (bracket, putByteString, throwIO, toS)
+import System.Directory (canonicalizePath)
+import System.FilePath (isAbsolute, takeDirectory, takeFileName, (</>))
+import System.Posix.Files (getSymbolicLinkStatus, isSocket, isSymbolicLink)
+import System.Posix.User (getEffectiveUserID)
+import System.Timeout (timeout)
+
+data ExternalSigner = ExternalSigner
+  { signerPath :: FilePath,
+    signerBatchId :: ByteString,
+    signerKeyName :: ByteString,
+    signerPublicKey :: ByteString,
+    signerEndpointId :: ByteString
+  }
+
+headerLength :: Int
+headerLength = 48
+
+operationTimeoutMicros :: Int
+operationTimeoutMicros = 5 * 1000 * 1000
+
+maxFingerprintLength :: Int
+maxFingerprintLength = 524626
+
+connectExternalSigner :: FilePath -> IO ExternalSigner
+connectExternalSigner path = do
+  safePath <- validateSocketPath path
+  batchId <- randomIdentifier
+  requestId <- randomIdentifier
+  body <- exchange safePath 0x01 0x81 batchId requestId mempty
+  (keyName, publicKey, endpointId) <- parseBody "DescribeKey" describeBody body
+  pure
+    ExternalSigner
+      { signerPath = safePath,
+        signerBatchId = batchId,
+        signerKeyName = keyName,
+        signerPublicKey = publicKey,
+        signerEndpointId = endpointId
+      }
+
+externalSignerPublicKey :: ExternalSigner -> Text
+externalSignerPublicKey ExternalSigner {..} =
+  T.decodeUtf8 signerKeyName <> ":" <> T.decodeUtf8 (B64.encode signerPublicKey)
+
+signFingerprint :: ExternalSigner -> ByteString -> IO ByteString
+signFingerprint ExternalSigner {..} fingerprintBytes = do
+  when (BS.null fingerprintBytes || BS.length fingerprintBytes > maxFingerprintLength) $
+    externalFailure "fingerprint is outside the NXSG PATH_INFO_V1 bound"
+  requestId <- randomIdentifier
+  let body = LBS.toStrict $ runPut $ do
+        putWord16be $ fromIntegral $ BS.length signerKeyName
+        putByteString signerKeyName
+        putByteString signerPublicKey
+        putByteString signerEndpointId
+        putWord32be $ fromIntegral $ BS.length fingerprintBytes
+        putByteString fingerprintBytes
+  response <- exchange signerPath 0x02 0x82 signerBatchId requestId body
+  (responseKeyName, responsePublicKey, responseEndpointId, signature) <-
+    parseBody "SignPathInfoV1" signBody response
+  unless (responseKeyName == signerKeyName && responsePublicKey == signerPublicKey) $
+    externalFailure "NXSG signing key identity changed during the command"
+  unless (responseEndpointId == signerEndpointId) $
+    externalFailure "NXSG signer endpoint changed during the command"
+  unless
+    (dverify (PublicKey signerPublicKey) fingerprintBytes (Signature signature))
+    (externalFailure "NXSG provider returned an invalid signature")
+  pure signature
+
+validateSocketPath :: FilePath -> IO FilePath
+validateSocketPath path = do
+  unless (isAbsolute path) $ externalFailure "NXSG signer socket path must be absolute"
+  status <- getSymbolicLinkStatus path
+  when (isSymbolicLink status) $ externalFailure "NXSG signer socket must not be a symlink"
+  unless (isSocket status) $ externalFailure "NXSG signer path is not a Unix socket"
+  parent <- canonicalizePath $ takeDirectory path
+  pure $ parent </> takeFileName path
+
+randomIdentifier :: IO ByteString
+randomIdentifier = go (8 :: Int)
+  where
+    go 0 = externalFailure "could not generate a nonzero NXSG correlation identifier"
+    go attempts = do
+      value <- getRandomBytes 16
+      if BS.any (/= 0) value then pure value else go (attempts - 1)
+
+exchange :: FilePath -> Word8 -> Word8 -> ByteString -> ByteString -> ByteString -> IO ByteString
+exchange path requestType responseType batchId requestId body = do
+  let operation = bracket (socket AF_UNIX Stream defaultProtocol) close $ \sock -> do
+        connect sock $ SockAddrUnix path
+        requireSameUser sock
+        Socket.sendAll sock $ encodeRequest requestType batchId requestId body
+        shutdown sock ShutdownSend
+        header <- receiveExactly sock headerLength
+        encodedBodyLength <- parseResponseHeader responseType batchId requestId header
+        bodyLength <-
+          maybe
+            (externalFailure "NXSG response body length cannot be represented on this platform")
+            pure
+            (toIntegralSized encodedBodyLength)
+        response <- receiveExactly sock bodyLength
+        trailing <- Socket.recv sock 1
+        unless (BS.null trailing) $ externalFailure "NXSG response has trailing bytes"
+        let status = BS.index header 7
+        if status == 0 then pure response else decodeFailure status response
+  timeout operationTimeoutMicros operation >>= \case
+    Nothing -> externalFailure "NXSG operation exceeded the five-second deadline"
+    Just response -> pure response
+
+requireSameUser :: Socket -> IO ()
+requireSameUser sock = do
+  peer <- getPeerCredential sock
+  effective <- getEffectiveUserID
+  case peer of
+    (_, Just peerUid, _)
+      | fromIntegral peerUid == (fromIntegral effective :: Integer) -> pure ()
+    _ -> externalFailure "NXSG provider peer UID does not match the Cachix process"
+
+encodeRequest :: Word8 -> ByteString -> ByteString -> ByteString -> ByteString
+encodeRequest requestType batchId requestId body =
+  LBS.toStrict $ runPut $ do
+    putByteString "NXSG"
+    putWord8 1
+    putWord8 0
+    putWord8 requestType
+    putWord8 0
+    putWord32be 0
+    putWord32be $ fromIntegral $ BS.length body
+    putByteString batchId
+    putByteString requestId
+    putByteString body
+
+parseResponseHeader :: Word8 -> ByteString -> ByteString -> ByteString -> IO Word32
+parseResponseHeader responseType batchId requestId encoded = do
+  (magic, major, minor, actualType, status, flags, bodyLength, actualBatch, actualRequest) <-
+    parseBody "response header" responseHeader encoded
+  unless (magic == "NXSG" && major == 1 && minor == 0) $
+    externalFailure "NXSG response version or magic does not match"
+  unless (actualType == responseType) $ externalFailure "NXSG response type does not match request"
+  unless (status <= 9 && flags == 0) $ externalFailure "NXSG response status or flags are invalid"
+  unless (actualBatch == batchId && actualRequest == requestId) $
+    externalFailure "NXSG response correlation identifiers do not match"
+  let bound :: Word32
+      bound
+        | status /= 0 = 1026
+        | responseType == 0x81 = 179
+        | responseType == 0x82 = 242
+        | otherwise = 0
+  when (bodyLength > bound) $ externalFailure "NXSG response body exceeds its message bound"
+  pure bodyLength
+
+responseHeader :: Get (ByteString, Word8, Word8, Word8, Word8, Word32, Word32, ByteString, ByteString)
+responseHeader = do
+  magic <- getByteString 4
+  major <- getWord8
+  minor <- getWord8
+  messageType <- getWord8
+  status <- getWord8
+  flags <- getWord32be
+  bodyLength <- getWord32be
+  batchId <- getByteString 16
+  requestId <- getByteString 16
+  pure (magic, major, minor, messageType, status, flags, bodyLength, batchId, requestId)
+
+describeBody :: Get (ByteString, ByteString, ByteString)
+describeBody = do
+  keyName <- getKeyName
+  algorithm <- getWord8
+  unless (algorithm == 1) $ MonadFail.fail "unsupported signing algorithm"
+  publicKey <- getByteString 32
+  endpointId <- getByteString 16
+  when (BS.all (== 0) endpointId) $ MonadFail.fail "zero endpoint identifier"
+  pure (keyName, publicKey, endpointId)
+
+signBody :: Get (ByteString, ByteString, ByteString, ByteString)
+signBody = do
+  keyName <- getKeyName
+  publicKey <- getByteString 32
+  endpointId <- getByteString 16
+  signature <- getByteString 64
+  pure (keyName, publicKey, endpointId, signature)
+
+getKeyName :: Get ByteString
+getKeyName = do
+  length' <- fromIntegral <$> getWord16be
+  unless (length' >= 1 && length' <= 128) $ MonadFail.fail "key name length"
+  keyName <- getByteString length'
+  unless (validKeyName keyName) $ MonadFail.fail "key name syntax"
+  pure keyName
+
+validKeyName :: ByteString -> Bool
+validKeyName name =
+  maybe False isAlphaNumeric (fst <$> BS.uncons name)
+    && BS.all (\byte -> isAlphaNumeric byte || byte `elem` [46, 95, 45]) name
+  where
+    isAlphaNumeric byte =
+      (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
+
+decodeFailure :: Word8 -> ByteString -> IO a
+decodeFailure status encoded = do
+  diagnostic <- parseBody "error response" errorBody encoded
+  externalFailure $ "NXSG " <> statusName status <> ": " <> diagnostic
+
+errorBody :: Get Text
+errorBody = do
+  length' <- fromIntegral <$> getWord16be
+  unless (length' <= 1024) $ MonadFail.fail "diagnostic length"
+  bytes <- getByteString length'
+  diagnostic <- either (const $ MonadFail.fail "diagnostic UTF-8") pure $ T.decodeUtf8' bytes
+  when (Text.any isControl diagnostic) $ MonadFail.fail "diagnostic control character"
+  pure diagnostic
+
+statusName :: Word8 -> Text
+statusName = \case
+  1 -> "Malformed"
+  2 -> "UnsupportedVersion"
+  3 -> "Unauthorized"
+  4 -> "KeyMismatch"
+  5 -> "InvalidFingerprint"
+  6 -> "Unavailable"
+  7 -> "DeadlineExceeded"
+  8 -> "Internal"
+  9 -> "Overloaded"
+  _ -> "Unknown"
+
+receiveExactly :: Socket -> Int -> IO ByteString
+receiveExactly sock expected = go expected []
+  where
+    go 0 chunks = pure $ BS.concat $ reverse chunks
+    go remaining chunks = do
+      chunk <- Socket.recv sock remaining
+      if BS.null chunk
+        then externalFailure "NXSG response ended before its declared length"
+        else go (remaining - BS.length chunk) (chunk : chunks)
+
+parseBody :: Text -> Get a -> ByteString -> IO a
+parseBody label parser encoded =
+  case runGetOrFail (parser <* ensureEmpty) $ LBS.fromStrict encoded of
+    Left _ -> externalFailure $ "invalid NXSG " <> label
+    Right (_, _, value) -> pure value
+  where
+    ensureEmpty = do
+      remaining <- getRemainingLazyByteString
+      unless (LBS.null remaining) $ MonadFail.fail "trailing bytes"
+
+externalFailure :: Text -> IO a
+externalFailure = throwIO . ExternalSignerError
