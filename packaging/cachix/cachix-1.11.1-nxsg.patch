+                  { cachixoptions = Prelude.error "import evaluated Cachix options before the signer guard",
+                    clientenv = Prelude.error "import evaluated the client environment before the signer guard",
+                    config = Prelude.error "import evaluated config before the signer guard"
+                  }
+              poisonedAwsInput = Prelude.error "import evaluated the AWS discovery input before the signer guard"
+           in Import.import' poisonedEnv options "example" poisonedAwsInput
