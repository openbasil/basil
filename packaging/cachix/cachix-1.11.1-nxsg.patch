+
+spec :: Spec
+spec = do
+  describe "CLI and credential selection" $ do
+    it "parses --signer-socket on push" $
+      case parseCommand ["push", "--signer-socket", "/run/cachix/nxsg.sock", "example", "/nix/store/example"] of
